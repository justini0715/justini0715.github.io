---
import type { BlogEntry } from '../../lib/content';
import MetaRow from '../site/MetaRow.astro';
import TagChipList from '../site/TagChipList.astro';

interface Props {
  post: BlogEntry;
  formattedDate: string;
  formattedUpdatedDate?: string;
  seriesContext: string;
}

const { post, formattedDate, formattedUpdatedDate, seriesContext } = Astro.props;
---

<aside class="panel utility-panel technical-article-meta-panel">
  <p class="eyebrow">Entry context</p>
  <p class="meta-note">{seriesContext}</p>

  <MetaRow
    items={[
      formattedDate,
      formattedUpdatedDate ? `updated · ${formattedUpdatedDate}` : '',
      `category · ${post.data.category}`,
      post.data.seriesTitle ? `series · ${post.data.seriesTitle}` : ''
    ]}
  />

  <TagChipList items={post.data.tags} />
</aside>
