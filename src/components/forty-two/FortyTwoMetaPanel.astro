---
import type { FortyTwoEntry } from '../../lib/content';
import MetaRow from '../site/MetaRow.astro';
import TagChipList from '../site/TagChipList.astro';

interface Props {
  post: FortyTwoEntry;
  formattedDate: string;
  seriesContext: string;
}

const { post, formattedDate, seriesContext } = Astro.props;
---

<aside class="panel utility-panel forty-two-meta-panel">
  <p class="eyebrow">Entry context</p>
  <p class="meta-note">{seriesContext}</p>

  <MetaRow
    items={[
      formattedDate,
      post.data.seriesTitle ?? '',
      post.data.seriesOrder ? `order · ${post.data.seriesOrder}` : '',
      post.data.difficulty ? `difficulty · ${post.data.difficulty}` : ''
    ]}
  />

  <TagChipList items={post.data.tags} />
</aside>
