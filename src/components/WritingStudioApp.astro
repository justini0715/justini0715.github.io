---
import { BLOG_CATEGORIES, CATEGORY_LABELS, SERIES_PRESETS, TECH_BLOG_CATEGORIES } from '../lib/studio/blogStudio';

interface SeedPost {
  collection: 'blog' | 'forty-two';
  extension: '.md' | '.mdx';
  slug: string;
  title: string;
  description: string;
  pubDate: string;
  updatedDate: string;
  category: string;
  tags: string[];
  series: string;
  seriesTitle: string;
  seriesOrder: string;
  difficulty: string;
  featured: boolean;
  draft: boolean;
  body: string;
}

interface Props {
  initialPosts?: SeedPost[];
}

const { initialPosts = [] } = Astro.props;
---

<section id="studio-app" class="section studio-shell-section">
  <script type="application/json" id="studio-seed">{JSON.stringify(initialPosts)}</script>
  <div class="container studio-shell studio-shell--editorial">
    <header class="studio-topbar">
      <div class="studio-topbar__identity">
        <p class="eyebrow">원고 데스크</p>
        <div>
          <h1>Writing Studio</h1>
          <p id="studio-folder" class="studio-topbar__hint">저장 위치: 폴더 미연결</p>
        </div>
      </div>

      <div class="studio-topbar__status-block">
        <p class="studio-topbar__label">현재 문서</p>
        <strong id="studio-current-document" class="studio-topbar__document-title">새 글</strong>
        <div class="studio-topbar__status">
          <span id="studio-host-badge" class="studio-pill studio-pill--ok">로컬 전용</span>
          <span id="studio-connection-badge" class="studio-pill">폴더 연결 필요</span>
          <span id="studio-dirty-badge" class="studio-pill">파일 저장됨</span>
        </div>
        <p id="studio-folder-detail" class="studio-topbar__hint studio-topbar__hint--sub">blog · 42 디렉터리 상태를 아직 확인하지 못했습니다.</p>
      </div>

      <div class="studio-topbar__actions-block">
        <div class="studio-topbar__actions">
          <button id="studio-library-toggle" class="button button--ghost" type="button">라이브러리</button>
          <button id="studio-connect" class="button button--ghost" type="button">폴더 연결</button>
          <button id="studio-save" class="button studio-save-button" type="button">저장</button>
        </div>
      </div>
    </header>

    <div id="studio-layout" class="studio-layout">
      <button id="studio-overlay" class="studio-overlay" type="button" hidden aria-label="열린 패널 닫기"></button>

      <aside id="studio-library-shell" class="studio-library-shell" hidden>
        <div class="studio-library-head">
          <div>
            <p class="eyebrow">라이브러리</p>
            <h3>새 문서와 기존 원고 열기</h3>
            <p>새 일반 글, 새 42 글을 만들고 기존 글을 다시 여는 왼쪽 드로어입니다.</p>
          </div>
        </div>

        <div class="studio-library-actions">
          <button class="studio-mini-button studio-preset" data-template="tech" type="button">새 기술 글</button>
          <button class="studio-mini-button studio-preset" data-template="42" type="button">새 42 글</button>
          <button class="studio-mini-button studio-preset" data-template="blank" type="button">빈 초안</button>
        </div>

        <div class="studio-library-filters">
          <input id="studio-search" class="studio-input" type="search" placeholder="제목 / slug 검색" />
          <div class="studio-filter-row">
            <select id="studio-filter-category" class="studio-select">
              <option value="all">목록: 모든 카테고리</option>
              {BLOG_CATEGORIES.map((category) => (
                <option value={category}>{CATEGORY_LABELS[category]}</option>
              ))}
            </select>
            <select id="studio-filter-draft" class="studio-select">
              <option value="all">목록: 전체 상태</option>
              <option value="public">공개 글</option>
              <option value="private">비공개 글</option>
            </select>
          </div>
        </div>

        <div id="studio-library" class="studio-library-list"></div>
      </aside>

      <main class="studio-editor-shell">
        <div class="studio-command-strip">
          <div class="studio-command-strip__group studio-command-strip__group--panels">
            <span class="studio-command-strip__label">오른쪽 패널</span>
            <button id="studio-preview-toggle" class="studio-command" type="button">미리보기</button>
            <button id="studio-settings-toggle" class="studio-command" type="button">문서 설정</button>
            <button id="studio-notes-toggle" class="studio-command" type="button">점검</button>
          </div>
          <div class="studio-command-strip__group studio-command-strip__group--tools">
            <span class="studio-command-strip__label">빠른 삽입</span>
            <button class="studio-command studio-toolbar" data-snippet="h2" type="button">H2</button>
            <button class="studio-command studio-toolbar" data-snippet="list" type="button">리스트</button>
            <button class="studio-command studio-toolbar" data-snippet="quote" type="button">인용</button>
            <button class="studio-command studio-toolbar" data-snippet="code" type="button">코드 블록</button>
            <button class="studio-command studio-toolbar" data-snippet="link" type="button">링크</button>
          </div>
        </div>

        <form id="studio-form" class="studio-editor-form" autocomplete="off">
          <label class="studio-title-field">
            <span class="visually-hidden">제목</span>
            <input id="studio-title" class="studio-title-input" type="text" placeholder="제목을 입력하세요" />
          </label>

          <label class="studio-subtitle-field">
            <span class="visually-hidden">설명</span>
            <input id="studio-description" class="studio-description-input" type="text" placeholder="리스트와 공유 카드에 보일 한 줄 설명" />
          </label>

          <section class="studio-tag-zone">
            <div class="studio-tag-zone__head">
              <div>
                <p class="eyebrow">Tags</p>
                <p>가벼운 태그만 먼저 붙이고, 더 많은 추천 태그는 펼쳐서 확인하세요.</p>
              </div>
              <div class="studio-tag-entry">
                <input id="studio-tag-input" class="studio-input studio-tag-input" type="text" placeholder="태그 입력 후 Enter" />
                <button id="studio-add-tag" class="button button--ghost" type="button">추가</button>
              </div>
            </div>

            <div id="studio-tag-chips" class="studio-chip-row studio-chip-row--selected"></div>

            <details class="studio-tag-drawer">
              <summary>추천 태그와 전체 태그 보기</summary>
              <div class="studio-tag-groups">
                <section>
                  <h4>추천 태그</h4>
                  <div id="studio-tag-category" class="studio-chip-row"></div>
                </section>

                <section>
                  <h4>전체 태그</h4>
                  <div id="studio-tag-library" class="studio-chip-row"></div>
                </section>
              </div>
            </details>
          </section>

          <label class="studio-body-field">
            <span class="visually-hidden">본문</span>
            <textarea id="studio-body" class="studio-body-textarea" placeholder="여기서부터 글을 쓰면 됩니다."></textarea>
          </label>
        </form>
      </main>

      <aside id="studio-sidepanel" class="studio-sidepanel" hidden>
        <div class="studio-sidepanel__header">
          <div>
            <p class="eyebrow">오른쪽 패널</p>
            <h3 id="studio-sidepanel-title">미리보기</h3>
          </div>
          <button id="studio-sidepanel-close" class="button button--ghost" type="button">닫기</button>
        </div>

        <div id="studio-panel-preview" class="studio-sidepanel__body">
          <div class="studio-paper">
            <div class="studio-paper__meta">
              <span id="studio-preview-category" class="studio-paper__badge">devlog</span>
              <span id="studio-preview-date">YYYY-MM-DD</span>
            </div>
            <h2 id="studio-preview-title" class="studio-paper__title">새 글</h2>
            <p id="studio-preview-description" class="studio-paper__description"></p>
            <div id="studio-preview-tags" class="studio-paper__tags"></div>
            <article id="studio-preview-body" class="studio-paper__body"></article>
          </div>
          <div class="studio-markdown-box">
            <div class="studio-markdown-box__head">
              <p class="eyebrow">원본 Markdown</p>
              <button id="studio-markdown-toggle" class="studio-command" type="button">Markdown 보기</button>
            </div>
            <textarea id="studio-markdown-output" class="studio-output" readonly hidden></textarea>
          </div>
        </div>

        <div id="studio-panel-settings" class="studio-sidepanel__body" hidden>
          <section class="studio-settings-card">
            <div class="studio-settings-card__head">
              <p class="eyebrow">공개 상태</p>
              <p>이 글이 블로그 목록에 보일지, 비공개로 숨길지 정합니다.</p>
            </div>
            <div class="studio-settings-grid">
              <label class="studio-field">
                <span>문서 타입</span>
                <select id="studio-document-type" class="studio-select">
                  <option value="tech">일반 기술 글</option>
                  <option value="42">42 글</option>
                </select>
              </label>
              <label class="studio-field">
                <span>공개 범위</span>
                <select id="studio-visibility" class="studio-select">
                  <option value="public">공개</option>
                  <option value="private">비공개</option>
                </select>
              </label>
              <label id="studio-category-field" class="studio-field">
                <span>카테고리</span>
                <select id="studio-category" class="studio-select">
                  {TECH_BLOG_CATEGORIES.map((category) => (
                    <option value={category}>{CATEGORY_LABELS[category]}</option>
                  ))}
                </select>
              </label>
              <div id="studio-fixed-category-note" class="studio-fixed-note" hidden>
                <span>카테고리</span>
                <strong>42</strong>
                <small>42 글은 category가 자동으로 `42`로 고정됩니다.</small>
              </div>
              <label class="studio-field">
                <span>발행일</span>
                <input id="studio-pubDate" class="studio-input" type="date" />
              </label>
            </div>
            <p class="studio-inline-note">비공개 상태면 저장돼도 블로그 목록에는 나타나지 않습니다.</p>
          </section>

          <section class="studio-settings-card">
            <div class="studio-settings-card__head">
              <p class="eyebrow">URL</p>
              <p>slug와 최종 경로를 관리합니다.</p>
            </div>
            <div class="studio-settings-grid">
              <label class="studio-field">
                <span>slug</span>
                <div class="studio-inline-input">
                  <input id="studio-slug" class="studio-input" type="text" placeholder="post-slug" />
                  <button id="studio-slugify" class="button button--ghost" type="button">자동</button>
                </div>
              </label>
              <p id="studio-route" class="studio-inline-note">/blog/post-slug/</p>
              <p id="studio-file-chip" class="studio-inline-note">src/content/blog/post-slug.md</p>
            </div>
          </section>

          <section id="studio-series-card" class="studio-settings-card" hidden>
            <div class="studio-settings-card__head">
              <p class="eyebrow">시리즈</p>
              <p>42 시리즈나 연재 흐름을 부드럽게 유지합니다.</p>
            </div>
            <div class="studio-settings-grid">
              <label class="studio-field">
                <span>시리즈</span>
                <select id="studio-series" class="studio-select">
                  <option value="">시리즈 없음</option>
                  {SERIES_PRESETS.map((series) => (
                    <option value={series.value}>{series.title}</option>
                  ))}
                </select>
              </label>
              <label class="studio-field">
                <span>시리즈 표시명</span>
                <input id="studio-series-title" class="studio-input" type="text" placeholder="예: 42 Systems" />
              </label>
              <label class="studio-field">
                <span>시리즈 순서</span>
                <input id="studio-series-order" class="studio-input" type="number" min="1" step="1" placeholder="1" />
              </label>
            </div>
            <div id="studio-series-library" class="studio-series-list"></div>
          </section>

          <details class="studio-settings-card studio-settings-card--advanced">
            <summary class="studio-settings-summary">고급 설정</summary>
            <div class="studio-settings-card__head">
              <p class="eyebrow">고급</p>
              <p>자주 안 쓰는 옵션은 접어두고 필요할 때만 엽니다.</p>
            </div>
            <div class="studio-settings-grid">
              <label class="studio-field">
                <span>수정일</span>
                <input id="studio-updatedDate" class="studio-input" type="date" />
              </label>
              <label class="studio-checkbox"><input id="studio-featured" type="checkbox" /><span>홈/상단 추천에 표시</span></label>
            </div>
            <label id="studio-difficulty-field" class="studio-field" hidden>
              <span>추가 메모</span>
              <input id="studio-difficulty" class="studio-input" type="text" placeholder="예: 이 글의 난이도, 후속 작업, 메모" />
            </label>
          </details>

          <section class="studio-settings-card">
            <div class="studio-settings-card__head">
              <p class="eyebrow">문서 작업</p>
              <p>복제, 다운로드, 임시저장 복구 같은 보조 작업은 설정 안으로 모아둡니다.</p>
            </div>
            <div class="studio-danger-row">
              <button id="studio-duplicate" class="button button--ghost" type="button">복제</button>
              <button id="studio-download" class="button button--ghost" type="button">Markdown 다운로드</button>
              <button id="studio-restore" class="button button--ghost" type="button">임시저장 복구</button>
            </div>
          </section>

          <section class="studio-settings-card studio-settings-card--danger">
            <div class="studio-settings-card__head">
              <p class="eyebrow">주의 영역</p>
              <p>완전 삭제보다 먼저 비공개 전환을 권장합니다.</p>
            </div>
            <div class="studio-danger-row">
              <button id="studio-soft-delete" class="button button--ghost" type="button">비공개로 전환</button>
              <button id="studio-hard-delete" class="button button--ghost studio-danger" type="button">완전 삭제</button>
            </div>
          </section>
        </div>

        <div id="studio-panel-notes" class="studio-sidepanel__body" hidden>
          <section class="studio-settings-card">
            <div class="studio-settings-card__head">
              <p class="eyebrow">점검</p>
              <p>지금 글이 저장 가능한 상태인지 바로 확인합니다.</p>
            </div>
            <ul id="studio-validation" class="studio-validation"></ul>
          </section>
          <section class="studio-settings-card">
            <div class="studio-settings-card__head">
              <p class="eyebrow">흐름</p>
              <p>원고 흐름을 끊지 않도록 꼭 필요한 사용 힌트만 남겨둡니다.</p>
            </div>
            <ul class="studio-checklist">
              <li>Chromium 데스크톱에서 로컬 폴더 쓰기가 가장 안정적입니다.</li>
              <li>Safari / Firefox / mobile에서는 다운로드 저장 fallback으로 사용합니다.</li>
              <li>배포본에서는 editor가 잠기고 localhost에서만 활성화됩니다.</li>
              <li>저장은 <code>⌘/Ctrl + S</code> 단축키로도 가능합니다.</li>
              <li>저장 후 최종 반영은 git commit / push가 필요합니다.</li>
            </ul>
          </section>
        </div>
      </aside>
    </div>
  </div>

  <div id="studio-toast" class="studio-toast" hidden></div>
</section>

<script>
  import {
    BLOG_CATEGORIES,
    CATEGORY_LABELS,
    SERIES_PRESETS,
    STUDIO_COLLECTION_META,
    collectionKeyForCategory,
    clonePost,
    collectSeriesStats,
    collectTagStats,
    createPostTemplate,
    getCollectionDirectory,
    getPostFilePath,
    getPostRoute,
    parsePostFile,
    renderMarkdownPreview,
    serializePost,
    seriesTitleFor,
    slugifyTitle,
    validatePost,
    normalizeTags
  } from '../lib/studio/blogStudio';

  const STATUS_TONES = ['neutral', 'ok', 'warn', 'error'];
  const HANDLE_DB = 'writing-studio-handles';
  const HANDLE_STORE = 'handles';
  const HANDLE_KEY = 'repo-root';
  const SNAPSHOT_KEY = 'writing-studio-snapshot';
  const INITIAL_SEED = JSON.parse(document.getElementById('studio-seed')?.textContent || '[]');

  const state = {
    repoHandle: null,
    contentRootHandle: null,
    blogHandle: null,
    fortyTwoHandle: null,
    supportsFileAccess: 'showDirectoryPicker' in window,
    posts: [],
    currentId: '',
    search: '',
    filterCategory: 'all',
    filterDraft: 'all',
    sideMode: '',
    libraryOpen: false,
    markdownVisible: false,
    snapshotAvailable: false,
    toastTimer: null
  };

  const $ = (selector) => document.querySelector(selector);

  const elements = {
    app: $('#studio-app'),
    overlay: $('#studio-overlay'),
    hostBadge: $('#studio-host-badge'),
    connectionBadge: $('#studio-connection-badge'),
    dirtyBadge: $('#studio-dirty-badge'),
    libraryToggle: $('#studio-library-toggle'),
    connect: $('#studio-connect'),
    save: $('#studio-save'),
    layout: $('#studio-layout'),
    libraryShell: $('#studio-library-shell'),
    folder: $('#studio-folder'),
    folderDetail: $('#studio-folder-detail'),
    currentDocument: $('#studio-current-document'),
    fileChip: $('#studio-file-chip'),
    route: $('#studio-route'),
    search: $('#studio-search'),
    filterCategory: $('#studio-filter-category'),
    filterDraft: $('#studio-filter-draft'),
    library: $('#studio-library'),
    title: $('#studio-title'),
    description: $('#studio-description'),
    documentType: $('#studio-document-type'),
    category: $('#studio-category'),
    categoryField: $('#studio-category-field'),
    fixedCategoryNote: $('#studio-fixed-category-note'),
    visibility: $('#studio-visibility'),
    pubDate: $('#studio-pubDate'),
    updatedDate: $('#studio-updatedDate'),
    featured: $('#studio-featured'),
    slug: $('#studio-slug'),
    slugify: $('#studio-slugify'),
    series: $('#studio-series'),
    seriesCard: $('#studio-series-card'),
    seriesTitle: $('#studio-series-title'),
    seriesOrder: $('#studio-series-order'),
    difficultyField: $('#studio-difficulty-field'),
    difficulty: $('#studio-difficulty'),
    body: $('#studio-body'),
    duplicate: $('#studio-duplicate'),
    download: $('#studio-download'),
    restore: $('#studio-restore'),
    softDelete: $('#studio-soft-delete'),
    hardDelete: $('#studio-hard-delete'),
    previewToggle: $('#studio-preview-toggle'),
    settingsToggle: $('#studio-settings-toggle'),
    notesToggle: $('#studio-notes-toggle'),
    sidepanel: $('#studio-sidepanel'),
    sidepanelTitle: $('#studio-sidepanel-title'),
    sidepanelClose: $('#studio-sidepanel-close'),
    panelPreview: $('#studio-panel-preview'),
    panelSettings: $('#studio-panel-settings'),
    panelNotes: $('#studio-panel-notes'),
    previewCategory: $('#studio-preview-category'),
    previewDate: $('#studio-preview-date'),
    previewTitle: $('#studio-preview-title'),
    previewDescription: $('#studio-preview-description'),
    previewTags: $('#studio-preview-tags'),
    previewBody: $('#studio-preview-body'),
    markdownToggle: $('#studio-markdown-toggle'),
    markdownOutput: $('#studio-markdown-output'),
    tagInput: $('#studio-tag-input'),
    addTag: $('#studio-add-tag'),
    tagChips: $('#studio-tag-chips'),
    tagCategory: $('#studio-tag-category'),
    tagLibrary: $('#studio-tag-library'),
    seriesLibrary: $('#studio-series-library'),
    validation: $('#studio-validation'),
    toast: $('#studio-toast'),
    presets: document.querySelectorAll('.studio-preset'),
    toolbars: document.querySelectorAll('.studio-toolbar'),
    shell: $('.studio-shell')
  };

  function nowDate() {
    return new Date().toISOString().slice(0, 10);
  }

  function currentPost() {
    return state.posts.find((post) => post.id === state.currentId) ?? null;
  }

  function makeRecord(post) {
    return { ...post, id: crypto.randomUUID() };
  }

  function createSeedRecord(seed) {
    const collection = seed.collection ?? collectionKeyForCategory(seed.category === '42' ? '42' : 'devlog');
    return makeRecord({
      collection,
      originalCollection: collection,
      extension: seed.extension ?? '.md',
      originalExtension: seed.extension ?? '.md',
      slug: seed.slug,
      originalSlug: seed.slug,
      title: seed.title,
      description: seed.description,
      pubDate: seed.pubDate,
      updatedDate: seed.updatedDate,
      category: seed.category,
      tags: [...(seed.tags || [])],
      series: seed.series,
      seriesTitle: seed.seriesTitle,
      seriesOrder: seed.seriesOrder,
      difficulty: seed.difficulty,
      featured: Boolean(seed.featured),
      draft: Boolean(seed.draft),
      body: seed.body || '',
      templateKind: collection === 'forty-two' ? '42' : 'tech',
      dirty: false,
      deleted: false
    });
  }

  function setPill(element, label, tone = 'neutral') {
    for (const name of STATUS_TONES) {
      element.classList.remove(`studio-pill--${name}`);
    }
    element.classList.add(`studio-pill--${tone}`);
    element.textContent = label;
  }

  function toast(message, tone = 'neutral') {
    if (!elements.toast) return;
    elements.toast.textContent = message;
    elements.toast.hidden = false;
    elements.toast.dataset.tone = tone;
    clearTimeout(state.toastTimer);
    state.toastTimer = window.setTimeout(() => {
      elements.toast.hidden = true;
    }, 2400);
  }

  function saveSnapshot() {
    const post = currentPost();
    if (!post) return;
    const snapshot = {
      savedAt: new Date().toISOString(),
      post: { ...post, tags: [...post.tags] },
      folderName: state.repoHandle?.name ?? ''
    };
    localStorage.setItem(SNAPSHOT_KEY, JSON.stringify(snapshot));
    state.snapshotAvailable = true;
    elements.restore.disabled = false;
  }

  function clearSnapshot() {
    localStorage.removeItem(SNAPSHOT_KEY);
    state.snapshotAvailable = false;
    elements.restore.disabled = true;
  }

  function loadSnapshot() {
    try {
      const raw = localStorage.getItem(SNAPSHOT_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  }

  async function openHandleDb() {
    return await new Promise((resolve, reject) => {
      const request = indexedDB.open(HANDLE_DB, 1);
      request.onupgradeneeded = () => request.result.createObjectStore(HANDLE_STORE);
      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error);
    });
  }

  async function saveRepoHandle(handle) {
    try {
      const db = await openHandleDb();
      await new Promise((resolve, reject) => {
        const tx = db.transaction(HANDLE_STORE, 'readwrite');
        tx.objectStore(HANDLE_STORE).put(handle, HANDLE_KEY);
        tx.oncomplete = () => resolve(undefined);
        tx.onerror = () => reject(tx.error);
      });
      db.close();
    } catch {
      // ignore
    }
  }

  async function loadRepoHandle() {
    try {
      const db = await openHandleDb();
      const handle = await new Promise((resolve, reject) => {
        const tx = db.transaction(HANDLE_STORE, 'readonly');
        const request = tx.objectStore(HANDLE_STORE).get(HANDLE_KEY);
        request.onsuccess = () => resolve(request.result ?? null);
        request.onerror = () => reject(request.error);
      });
      db.close();
      return handle;
    } catch {
      return null;
    }
  }

  async function getDirectoryIfExists(parentHandle, name) {
    try {
      return await parentHandle.getDirectoryHandle(name);
    } catch {
      return null;
    }
  }

  async function resolveContentHandles(selectedHandle) {
    let contentRootHandle = null;
    let blogHandle = null;
    let fortyTwoHandle = null;

    const srcHandle = await getDirectoryIfExists(selectedHandle, 'src');
    if (srcHandle) {
      const contentHandle = await getDirectoryIfExists(srcHandle, 'content');
      if (contentHandle) contentRootHandle = contentHandle;
    }

    if (!contentRootHandle) {
      const directBlog = await getDirectoryIfExists(selectedHandle, 'blog');
      const directFortyTwo = await getDirectoryIfExists(selectedHandle, 'forty-two');
      if (directBlog || directFortyTwo) {
        contentRootHandle = selectedHandle;
        blogHandle = directBlog;
        fortyTwoHandle = directFortyTwo;
      }
    }

    if (!contentRootHandle) {
      if (selectedHandle.name === 'blog') {
        blogHandle = selectedHandle;
      }
      if (selectedHandle.name === 'forty-two') {
        fortyTwoHandle = selectedHandle;
      }
    }

    if (contentRootHandle) {
      blogHandle ||= await getDirectoryIfExists(contentRootHandle, 'blog');
      fortyTwoHandle ||= await getDirectoryIfExists(contentRootHandle, 'forty-two');
    }

    return { contentRootHandle, blogHandle, fortyTwoHandle };
  }

  function collectionHandleFor(key) {
    return key === 'forty-two' ? state.fortyTwoHandle : state.blogHandle;
  }

  async function ensureCollectionHandle(key) {
    const current = collectionHandleFor(key);
    if (current) return current;
    if (!state.contentRootHandle) return null;
    const created = await state.contentRootHandle.getDirectoryHandle(key, { create: true });
    if (key === 'forty-two') state.fortyTwoHandle = created;
    else state.blogHandle = created;
    return created;
  }

  function collectionStatusText() {
    const labels = {
      blog: STUDIO_COLLECTION_META.blog.directory,
      'forty-two': STUDIO_COLLECTION_META['forty-two'].directory
    };
    return [
      `blog: ${state.blogHandle ? labels.blog : `${labels.blog} 미연결`}`,
      `42: ${state.fortyTwoHandle ? labels['forty-two'] : `${labels['forty-two']} 미연결`}`
    ].join(' · ');
  }

  async function connectRepo(forcePicker = false, silent = false) {
    if (!('showDirectoryPicker' in window)) {
      setPill(elements.connectionBadge, '폴더 연결 불가', 'warn');
      if (!silent) {
        toast('이 브라우저는 폴더 직접 쓰기를 지원하지 않습니다. 다운로드 방식으로만 사용 가능합니다.', 'warn');
      }
      return;
    }

    try {
      let repoHandle = null;
      if (!forcePicker) {
        repoHandle = await loadRepoHandle();
        if (repoHandle) {
          const permission = await repoHandle.queryPermission({ mode: 'readwrite' });
          if (permission !== 'granted') repoHandle = null;
        }
        if (!repoHandle && silent) {
          setPill(elements.connectionBadge, '폴더 연결 필요', 'warn');
          return;
        }
      }
      if (!repoHandle) {
        repoHandle = await window.showDirectoryPicker();
      }
      const { contentRootHandle, blogHandle, fortyTwoHandle } = await resolveContentHandles(repoHandle);
      state.repoHandle = repoHandle;
      state.contentRootHandle = contentRootHandle;
      state.blogHandle = blogHandle;
      state.fortyTwoHandle = fortyTwoHandle;
      await saveRepoHandle(repoHandle);
      await loadPostsFromFolder();
      const connectedCount = Number(Boolean(blogHandle)) + Number(Boolean(fortyTwoHandle));
      elements.folder.textContent = contentRootHandle
        ? `저장 위치: ${repoHandle.name} → src/content`
        : `저장 위치: ${repoHandle.name}`;
      elements.folderDetail.textContent = collectionStatusText();
      setPill(elements.connectionBadge, connectedCount ? `${connectedCount}개 폴더 연결` : '폴더 연결 필요', connectedCount ? 'ok' : 'warn');
      toast(
        connectedCount
          ? '레포 폴더 연결 완료. 일반 글과 42 글 컬렉션을 로컬 Markdown으로 불러옵니다.'
          : '폴더를 찾았지만 blog / forty-two 컬렉션은 아직 없습니다. 저장 시 필요한 폴더를 만듭니다.',
        connectedCount ? 'ok' : 'warn'
      );
    } catch (error) {
      console.error(error);
      if (silent) {
        setPill(elements.connectionBadge, '폴더 연결 필요', 'warn');
        return;
      }
      setPill(elements.connectionBadge, '연결 실패', 'error');
      toast('폴더 연결에 실패했습니다. 레포 루트, src/content, blog, 또는 forty-two 폴더를 선택해주세요.', 'error');
    }
  }

  async function loadPostsFromFolder() {
    const loaded = [];

    for (const [collectionKey, directoryHandle] of [
      ['blog', state.blogHandle],
      ['forty-two', state.fortyTwoHandle]
    ]) {
      if (!directoryHandle) continue;
      for await (const [name, handle] of directoryHandle.entries()) {
        if (handle.kind !== 'file' || !/\.(md|mdx)$/i.test(name) || name === '.gitkeep') continue;
        const file = await handle.getFile();
        loaded.push(makeRecord(parsePostFile(name, await file.text(), collectionKey)));
      }
    }

    loaded.sort((a, b) => b.pubDate.localeCompare(a.pubDate) || a.title.localeCompare(b.title));
    state.posts = loaded.length ? loaded : [makeRecord(createPostTemplate('tech'))];
    state.currentId = state.posts[0].id;
    renderAll();
  }

  function isFortyTwoDocument(post) {
    return post.collection === 'forty-two' || post.category === '42';
  }

  function syncDocumentTypeUI(post) {
    const is42 = isFortyTwoDocument(post);
    elements.documentType.value = is42 ? '42' : 'tech';
    elements.categoryField.hidden = is42;
    elements.fixedCategoryNote.hidden = !is42;
    elements.seriesCard.hidden = !is42;
    elements.difficultyField.hidden = !is42;
  }

  function updateBadges() {
    const post = currentPost();
    const connectedCount = Number(Boolean(state.blogHandle)) + Number(Boolean(state.fortyTwoHandle));
    const fallbackMode = !state.supportsFileAccess;
    setPill(elements.hostBadge, fallbackMode ? '다운로드 전용' : '로컬 작업중', fallbackMode ? 'warn' : 'ok');
    setPill(
      elements.connectionBadge,
      fallbackMode ? '브라우저 fallback' : connectedCount ? `${connectedCount}개 폴더 연결` : '폴더 연결 필요',
      fallbackMode ? 'warn' : connectedCount ? 'ok' : 'warn'
    );
    setPill(elements.dirtyBadge, post?.dirty ? '임시저장' : '파일 저장됨', post?.dirty ? 'warn' : 'ok');
    elements.fileChip.textContent = post ? getPostFilePath(post) : `${getCollectionDirectory('blog')}/post-slug.md`;
    elements.currentDocument.textContent = post?.title?.trim() || '제목 없는 초안';
    elements.folder.textContent = fallbackMode
      ? '저장 방식: Markdown 다운로드'
      : state.repoHandle
        ? `저장 위치: ${state.repoHandle.name}`
        : '저장 위치: 폴더 미연결';
    elements.folderDetail.textContent = fallbackMode
      ? 'Chrome / Edge / Brave가 아니면 로컬 폴더 저장 대신 다운로드 방식으로 동작합니다.'
      : collectionStatusText();
    elements.libraryToggle.textContent = state.libraryOpen ? '라이브러리 닫기' : '라이브러리';
    elements.connect.hidden = fallbackMode;
    elements.connect.textContent = connectedCount ? '폴더 변경' : '폴더 연결';
    elements.save.textContent = fallbackMode ? '다운로드 저장' : '저장';
  }

  function selectPost(id) {
    state.currentId = id;
    state.libraryOpen = false;
    renderAll();
  }

  function createNew(kind) {
    const record = makeRecord(createPostTemplate(kind));
    state.posts.unshift(record);
    state.currentId = record.id;
    state.libraryOpen = false;
    saveSnapshot();
    renderAll();
    toast(kind === '42' ? '42 템플릿 새 글을 만들었습니다.' : '새 글 초안을 만들었습니다.', 'ok');
  }

  function duplicateCurrentPost() {
    const post = currentPost();
    if (!post) return;
    const duplicate = makeRecord(clonePost(post));
    state.posts.unshift(duplicate);
    state.currentId = duplicate.id;
    saveSnapshot();
    renderAll();
    toast('현재 글을 복제해서 새 드래프트로 만들었습니다.', 'ok');
  }

  function fillForm(post) {
    elements.title.value = post.title;
    elements.description.value = post.description;
    elements.category.value = post.category === '42' ? 'devlog' : post.category;
    elements.visibility.value = post.draft ? 'private' : 'public';
    elements.pubDate.value = post.pubDate;
    elements.updatedDate.value = post.updatedDate;
    elements.featured.checked = post.featured;
    elements.slug.value = post.slug;
    elements.series.value = post.series;
    elements.seriesTitle.value = post.seriesTitle;
    elements.seriesOrder.value = post.seriesOrder;
    elements.difficulty.value = post.difficulty;
    elements.body.value = post.body;
    elements.route.textContent = getPostRoute(post);
    syncDocumentTypeUI(post);
    renderSelectedTags(post);
  }

  function syncFromForm() {
    const post = currentPost();
    if (!post) return;
    const documentType = elements.documentType.value;
    post.title = elements.title.value.trim();
    post.description = elements.description.value.trim();
    post.category = documentType === '42' ? '42' : elements.category.value;
    post.draft = elements.visibility.value === 'private';
    post.pubDate = elements.pubDate.value;
    post.updatedDate = elements.updatedDate.value;
    post.featured = elements.featured.checked;
    post.slug = elements.slug.value.trim();
    post.collection = collectionKeyForCategory(post.category);
    post.templateKind = documentType === '42' ? '42' : 'tech';
    post.series = documentType === '42' ? elements.series.value.trim() : '';
    post.seriesTitle = documentType === '42' ? elements.seriesTitle.value.trim() : '';
    post.seriesOrder = documentType === '42' ? elements.seriesOrder.value.trim() : '';
    post.difficulty = documentType === '42' ? elements.difficulty.value.trim() : '';
    post.body = elements.body.value;
    post.dirty = true;
    if (post.series && !post.seriesTitle) {
      post.seriesTitle = seriesTitleFor(post.series);
      elements.seriesTitle.value = post.seriesTitle;
    }
    if (documentType !== '42') {
      post.tags = post.tags.filter((tag) => tag.toLowerCase() !== '42');
    } else if (!post.tags.includes('42')) {
      post.tags = normalizeTags(['42', ...post.tags]);
    }
    elements.route.textContent = getPostRoute(post);
    syncDocumentTypeUI(post);
    saveSnapshot();
    renderLibrary();
    renderPanels();
    updateBadges();
  }

  function renderSelectedTags(post) {
    elements.tagChips.innerHTML = '';
    if (!post.tags.length) {
      elements.tagChips.innerHTML = '<span class="studio-chip studio-chip--empty">아직 태그 없음</span>';
      return;
    }
    for (const tag of post.tags) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'studio-chip studio-chip--selected';
      button.innerHTML = `<span>#${tag}</span><strong>×</strong>`;
      button.addEventListener('click', () => toggleTag(tag));
      elements.tagChips.appendChild(button);
    }
  }

  function renderPreview(post) {
    elements.previewCategory.textContent = CATEGORY_LABELS[post.category] ?? post.category;
    elements.previewDate.textContent = post.pubDate || '날짜 없음';
    elements.previewTitle.textContent = post.title || '제목 없음';
    elements.previewDescription.textContent = post.description || '설명을 아직 입력하지 않았습니다.';
    elements.previewTags.innerHTML = post.tags.length
      ? post.tags.map((tag) => `<span class="studio-chip studio-chip--paper">#${tag}</span>`).join('')
      : '<span class="studio-chip studio-chip--empty">태그 없음</span>';
    elements.previewBody.innerHTML = renderMarkdownPreview(post.body || '');
    elements.markdownOutput.value = serializePost(post);
  }

  function renderValidation(post) {
    const issues = validatePost(post, state.posts);
    elements.validation.innerHTML = '';
    if (!issues.length) {
      elements.validation.innerHTML = '<li class="studio-validation__ok">저장 가능한 상태입니다.</li>';
      return issues;
    }
    for (const issue of issues) {
      const item = document.createElement('li');
      item.className = `studio-validation__item studio-validation__item--${issue.level}`;
      item.textContent = issue.message;
      elements.validation.appendChild(item);
    }
    return issues;
  }

  function getCategoryTagStats() {
    const post = currentPost();
    const counts = new Map();
    for (const item of state.posts) {
      if (item.deleted || item.category !== post.category) continue;
      for (const tag of item.tags) {
        if (tag.startsWith('42') && post.category !== '42') continue;
        counts.set(tag, (counts.get(tag) ?? 0) + 1);
      }
    }
    return [...counts.entries()]
      .map(([tag, count]) => ({ tag, count }))
      .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag))
      .slice(0, 10);
  }

  function renderTagGroup(container, stats, activeTags) {
    container.innerHTML = '';
    if (!stats.length) {
      container.innerHTML = '<span class="studio-chip studio-chip--empty">기존 태그 없음</span>';
      return;
    }
    for (const stat of stats) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = `studio-chip studio-chip--library ${activeTags.includes(stat.tag) ? 'is-active' : ''}`;
      button.innerHTML = `<span>#${stat.tag}</span><span class="studio-chip__count">${stat.count}</span>`;
      button.addEventListener('click', () => toggleTag(stat.tag));
      container.appendChild(button);
    }
  }

  function renderSeriesLibrary(post) {
    const stats = collectSeriesStats(state.posts);
    const merged = [...SERIES_PRESETS.map((preset) => ({ value: preset.value, title: preset.title, count: 0 })), ...stats].reduce(
      (accumulator, item) => {
        const existing = accumulator.find((candidate) => candidate.value === item.value);
        if (existing) {
          existing.count = Math.max(existing.count, item.count);
          existing.title = item.title || existing.title;
          return accumulator;
        }
        accumulator.push({ ...item });
        return accumulator;
      },
      []
    );

    elements.seriesLibrary.innerHTML = '';
    for (const item of merged) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = `studio-series ${post.series === item.value ? 'is-active' : ''}`;
      button.innerHTML = `<strong>${item.title}</strong><small>${item.value}${item.count ? ` · ${item.count}개` : ''}</small>`;
      button.addEventListener('click', () => {
        const current = currentPost();
        if (!current) return;
        current.series = item.value;
        current.seriesTitle = item.title;
        current.dirty = true;
        fillForm(current);
        saveSnapshot();
        renderPanels();
        updateBadges();
      });
      elements.seriesLibrary.appendChild(button);
    }
  }

  function renderPanels() {
    const post = currentPost();
    if (!post) return;
    renderPreview(post);
    renderValidation(post);
    renderTagGroup(elements.tagCategory, getCategoryTagStats(), post.tags);
    renderTagGroup(elements.tagLibrary, collectTagStats(state.posts).slice(0, 16), post.tags);
    renderSeriesLibrary(post);
  }

  function renderLibrary() {
    const filtered = state.posts.filter((post) => {
      if (post.deleted) return false;
      const search = state.search.trim().toLowerCase();
      const searchMatch = !search || post.title.toLowerCase().includes(search) || post.slug.toLowerCase().includes(search);
      const categoryMatch = state.filterCategory === 'all' || post.category === state.filterCategory;
      const draftMatch = state.filterDraft === 'all' || (state.filterDraft === 'private' ? post.draft : !post.draft);
      return searchMatch && categoryMatch && draftMatch;
    });

    elements.library.innerHTML = '';
    if (!filtered.length) {
      elements.library.innerHTML = '<p class="studio-empty">조건에 맞는 글이 없습니다.</p>';
      return;
    }

    for (const post of filtered) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = `studio-library-card ${post.id === state.currentId ? 'is-active' : ''}`;
      button.innerHTML = `
        <div class="studio-library-card__top">
          <span class="studio-library-card__category">${CATEGORY_LABELS[post.category] ?? post.category}</span>
          <span class="studio-library-card__state">${post.draft ? '비공개' : '공개'}</span>
        </div>
        <strong>${post.title || '제목 없음'}</strong>
        <p>${post.description || '설명 없음'}</p>
        <small>${post.pubDate} · ${getPostRoute(post)}</small>
        ${post.dirty ? '<span class="studio-library-card__dirty">임시저장</span>' : ''}
      `;
      button.addEventListener('click', () => selectPost(post.id));
      elements.library.appendChild(button);
    }
  }

  function renderAll() {
    const post = currentPost();
    elements.restore.disabled = !state.snapshotAvailable;
    renderLibrary();
    if (!post) return;
    fillForm(post);
    renderPanels();
    updateLayout();
    updateBadges();
  }

  function toggleTag(tag) {
    const post = currentPost();
    if (!post) return;
    post.tags = post.tags.includes(tag) ? post.tags.filter((item) => item !== tag) : normalizeTags([...post.tags, tag]);
    post.dirty = true;
    saveSnapshot();
    renderAll();
  }

  function addTagFromInput() {
    const post = currentPost();
    if (!post) return;
    const next = elements.tagInput.value.trim();
    if (!next) return;
    post.tags = normalizeTags([...post.tags, next]);
    post.dirty = true;
    elements.tagInput.value = '';
    saveSnapshot();
    renderAll();
  }

  async function saveCurrent() {
    const post = currentPost();
    if (!post) return;
    syncFromForm();
    if (!state.supportsFileAccess) {
      downloadCurrent();
      return;
    }
    if (!post.slug.trim() && post.title.trim()) {
      post.slug = slugifyTitle(post.title);
    }
    post.collection = collectionKeyForCategory(post.category);
    const errors = validatePost(post, state.posts).filter((issue) => issue.level === 'error');
    if (errors.length) {
      toast(errors[0].message, 'error');
      return;
    }

    const targetCollection = collectionKeyForCategory(post.category);
    const targetHandle = await ensureCollectionHandle(targetCollection);
    if (!targetHandle) {
      toast('폴더 미연결 상태입니다. 다운로드만 가능합니다.', 'warn');
      return;
    }

    const nextFileName = `${post.slug}${post.extension}`;
    const previousFileName = post.originalSlug ? `${post.originalSlug}${post.originalExtension}` : null;
    const previousHandle = collectionHandleFor(post.originalCollection);

    try {
      const fileHandle = await targetHandle.getFileHandle(nextFileName, { create: true });
      const writable = await fileHandle.createWritable();
      await writable.write(serializePost(post));
      await writable.close();
      if (previousFileName && previousHandle) {
        const movedCollection = post.originalCollection !== targetCollection;
        const renamedFile = previousFileName !== nextFileName;
        if (movedCollection || renamedFile) {
          await previousHandle.removeEntry(previousFileName);
        }
      }
      post.collection = targetCollection;
      post.originalCollection = targetCollection;
      post.originalExtension = post.extension;
      post.originalSlug = post.slug;
      post.dirty = false;
      clearSnapshot();
      renderAll();
      toast(`${getPostFilePath(post)} 저장 완료`, 'ok');
    } catch (error) {
      console.error(error);
      toast('파일 저장에 실패했습니다. 레포 루트 또는 src/content 폴더 권한을 다시 확인해주세요.', 'error');
    }
  }

  function downloadCurrent() {
    const post = currentPost();
    if (!post) return;
    syncFromForm();
    const blob = new Blob([serializePost(post)], { type: 'text/markdown;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = `${post.slug || 'post'}${post.extension}`;
    anchor.click();
    URL.revokeObjectURL(url);
    toast('Markdown 다운로드 완료', 'ok');
  }

  async function softDeleteCurrent() {
    const post = currentPost();
    if (!post) return;
    post.draft = true;
    if (!post.updatedDate) post.updatedDate = nowDate();
    post.dirty = true;
    fillForm(post);
    if (collectionHandleFor(post.originalCollection) || state.contentRootHandle) {
      await saveCurrent();
    } else {
      saveSnapshot();
      renderAll();
      toast('비공개 상태로 바꿨습니다. 저장하거나 다운로드해주세요.', 'warn');
    }
  }

  async function hardDeleteCurrent() {
    const post = currentPost();
    if (!post) return;
    if (!window.confirm(`정말 ${post.title || post.slug} 글을 완전히 삭제할까요?`)) return;
    try {
      if (post.originalSlug) {
        const originalHandle = collectionHandleFor(post.originalCollection) ?? collectionHandleFor(collectionKeyForCategory(post.category));
        if (originalHandle) {
          await originalHandle.removeEntry(`${post.originalSlug}${post.originalExtension}`);
        }
      }
      state.posts = state.posts.filter((candidate) => candidate.id !== post.id);
      if (!state.posts.length) state.posts = [makeRecord(createPostTemplate('tech'))];
      state.currentId = state.posts[0].id;
      clearSnapshot();
      renderAll();
      toast('글을 삭제했습니다.', 'ok');
    } catch (error) {
      console.error(error);
      toast('삭제에 실패했습니다. 폴더 권한 또는 파일 상태를 확인해주세요.', 'error');
    }
  }

  function restoreSnapshot() {
    const snapshot = loadSnapshot();
    if (!snapshot?.post) {
      toast('복원할 임시저장이 없습니다.', 'warn');
      return;
    }
    const restored = makeRecord({ ...snapshot.post, tags: [...(snapshot.post.tags ?? [])], dirty: true });
    const existingIndex = state.posts.findIndex((post) => post.slug === restored.slug);
    if (existingIndex >= 0) state.posts.splice(existingIndex, 1, restored);
    else state.posts.unshift(restored);
    state.currentId = restored.id;
    state.libraryOpen = false;
    state.snapshotAvailable = true;
    renderAll();
    toast('브라우저 임시저장을 복원했습니다.', 'ok');
  }

  function updateLayout() {
    const hasSidepanel = Boolean(state.sideMode);
    const hasLibrary = state.libraryOpen;

    elements.overlay.hidden = !(hasLibrary || hasSidepanel);
    elements.libraryShell.hidden = !hasLibrary;
    elements.sidepanel.hidden = !hasSidepanel;
    elements.layout.classList.toggle('has-library', hasLibrary);
    elements.layout.classList.toggle('has-sidepanel', hasSidepanel);
  }

  function closeChrome() {
    state.libraryOpen = false;
    state.sideMode = '';
    elements.panelPreview.hidden = true;
    elements.panelSettings.hidden = true;
    elements.panelNotes.hidden = true;
    elements.sidepanelTitle.textContent = '패널';
    elements.previewToggle.classList.remove('is-active');
    elements.settingsToggle.classList.remove('is-active');
    elements.notesToggle.classList.remove('is-active');
    updateLayout();
    updateBadges();
  }

  function setSideMode(mode) {
    const nextMode = state.sideMode === mode ? '' : mode;
    state.libraryOpen = false;
    state.sideMode = nextMode;
    elements.panelPreview.hidden = state.sideMode !== 'preview';
    elements.panelSettings.hidden = state.sideMode !== 'settings';
    elements.panelNotes.hidden = state.sideMode !== 'notes';
    const titles = {
      preview: '미리보기',
      settings: '문서 설정',
      notes: '점검'
    };
    elements.sidepanelTitle.textContent = titles[state.sideMode] ?? '패널';
    elements.previewToggle.classList.toggle('is-active', state.sideMode === 'preview');
    elements.settingsToggle.classList.toggle('is-active', state.sideMode === 'settings');
    elements.notesToggle.classList.toggle('is-active', state.sideMode === 'notes');
    updateLayout();
    updateBadges();
  }

  function toggleMarkdownOutput() {
    state.markdownVisible = !state.markdownVisible;
    elements.markdownOutput.hidden = !state.markdownVisible;
    elements.markdownToggle.textContent = state.markdownVisible ? 'Markdown 숨기기' : 'Markdown 보기';
  }

  function toggleLibrary() {
    state.libraryOpen = !state.libraryOpen;
    if (state.libraryOpen) {
      state.sideMode = '';
      elements.panelPreview.hidden = true;
      elements.panelSettings.hidden = true;
      elements.panelNotes.hidden = true;
      elements.sidepanelTitle.textContent = '패널';
      elements.previewToggle.classList.remove('is-active');
      elements.settingsToggle.classList.remove('is-active');
      elements.notesToggle.classList.remove('is-active');
    }
    updateLayout();
    updateBadges();
  }

  function applySnippet(kind) {
    const snippets = {
      h2: '\n## 새 섹션\n\n',
      list: '\n- 항목 1\n- 항목 2\n- 항목 3\n',
      quote: '\n> 인용문\n',
      code: '\n```ts\n// code\n```\n',
      link: '\n[링크 텍스트](https://example.com)\n'
    };
    const target = elements.body;
    const snippet = snippets[kind];
    if (!snippet) return;
    const start = target.selectionStart;
    const end = target.selectionEnd;
    target.setRangeText(snippet, start, end, 'end');
    target.focus();
    syncFromForm();
  }

  function wireFieldUpdates() {
    [
      elements.title,
      elements.description,
      elements.documentType,
      elements.category,
      elements.visibility,
      elements.pubDate,
      elements.updatedDate,
      elements.slug,
      elements.series,
      elements.seriesTitle,
      elements.seriesOrder,
      elements.difficulty,
      elements.body
    ].forEach((element) => {
      element.addEventListener('input', syncFromForm);
      element.addEventListener('change', syncFromForm);
    });

    [elements.featured].forEach((element) => element.addEventListener('change', syncFromForm));
  }

  function bindEvents() {
    elements.libraryToggle.addEventListener('click', toggleLibrary);
    elements.overlay.addEventListener('click', closeChrome);
    elements.connect.addEventListener('click', () => connectRepo(true));
    elements.save.addEventListener('click', saveCurrent);
    elements.search.addEventListener('input', () => {
      state.search = elements.search.value;
      renderLibrary();
    });
    elements.filterCategory.addEventListener('change', () => {
      state.filterCategory = elements.filterCategory.value;
      renderLibrary();
    });
    elements.filterDraft.addEventListener('change', () => {
      state.filterDraft = elements.filterDraft.value;
      renderLibrary();
    });
    elements.presets.forEach((button) => button.addEventListener('click', () => createNew(button.dataset.template)));
    elements.duplicate.addEventListener('click', duplicateCurrentPost);
    elements.download.addEventListener('click', downloadCurrent);
    elements.restore.addEventListener('click', restoreSnapshot);
    elements.slugify.addEventListener('click', () => {
      const post = currentPost();
      if (!post) return;
      post.slug = slugifyTitle(elements.title.value.trim() || post.title);
      post.dirty = true;
      fillForm(post);
      saveSnapshot();
      renderPanels();
      renderLibrary();
      updateBadges();
    });
    elements.addTag.addEventListener('click', addTagFromInput);
    elements.tagInput.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ',') {
        event.preventDefault();
        addTagFromInput();
      }
    });
    elements.softDelete.addEventListener('click', softDeleteCurrent);
    elements.hardDelete.addEventListener('click', hardDeleteCurrent);
    elements.previewToggle.addEventListener('click', () => setSideMode('preview'));
    elements.settingsToggle.addEventListener('click', () => setSideMode('settings'));
    elements.notesToggle.addEventListener('click', () => setSideMode('notes'));
    elements.sidepanelClose.addEventListener('click', () => setSideMode(state.sideMode));
    elements.markdownToggle.addEventListener('click', toggleMarkdownOutput);
    elements.toolbars.forEach((button) => button.addEventListener('click', () => applySnippet(button.dataset.snippet)));
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's') {
        event.preventDefault();
        saveCurrent();
        return;
      }
      if (event.key === 'Escape' && (state.libraryOpen || state.sideMode)) {
        closeChrome();
      }
    });
    wireFieldUpdates();
  }

  async function init() {
    bindEvents();
    state.posts = INITIAL_SEED.length ? INITIAL_SEED.map(createSeedRecord) : [makeRecord(createPostTemplate('tech'))];
    state.currentId = state.posts[0].id;
    state.snapshotAvailable = Boolean(loadSnapshot());
    elements.restore.disabled = !state.snapshotAvailable;
    renderAll();
    setSideMode('');
    if (state.supportsFileAccess) {
      await connectRepo(false, true);
    } else {
      toast('이 브라우저는 로컬 폴더 직접 쓰기를 지원하지 않습니다. 다운로드 방식으로 사용해주세요.', 'warn');
    }
  }

  init();
</script>

