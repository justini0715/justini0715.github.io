---
import { siteMeta } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-shell__footer">
  <div class="container footer-compact">
    <p class="footer-compact__brand">
      <strong>{siteMeta.shortTitle}</strong>
      <span>Static developer archive for projects, 42 records, and technical notes.</span>
    </p>

    <nav aria-label="Footer navigation" class="footer-compact__nav">
      {siteMeta.nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="footer-compact__meta">
      <a href={siteMeta.github} target="_blank" rel="noreferrer" aria-label="Open GitHub profile in a new tab">GitHub</a>
      <a href={siteMeta.repo} target="_blank" rel="noreferrer" aria-label="Open site repository in a new tab">Repository</a>
      <small>© {year} {siteMeta.shortTitle}</small>
    </div>
  </div>
</footer>
