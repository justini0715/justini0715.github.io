---
import { siteMeta } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-shell__footer">
  <div class="container footer-grid">
    <div class="footer-column">
      <p class="eyebrow">Issue 12 · editorial pass</p>
      <h2>{siteMeta.shortTitle}</h2>
      <p>
        A source-first portfolio and developer journal for project case studies, technical posts, and a growing 42 archive.
      </p>
    </div>

    <div class="footer-column">
      <p class="eyebrow">Browse</p>
      <ul class="footer-nav">
        {siteMeta.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-column">
      <p class="eyebrow">Elsewhere</p>
      <ul class="footer-links">
        <li><a href={siteMeta.github} target="_blank" rel="noreferrer">GitHub profile</a></li>
        <li><a href={siteMeta.repo} target="_blank" rel="noreferrer">Site repository</a></li>
        <li><a href="/blog">Latest writing</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-meta">
    <small>© {year} {siteMeta.shortTitle}. Built with Astro static output and deployed via GitHub Pages.</small>
    <small>Public routes stay static; `/studio` remains a locked local-only writing surface in production.</small>
  </div>
</footer>
