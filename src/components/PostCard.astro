---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(post.data.pubDate);
---

<article class="card post-card">
  <div class="card__meta">
    <span class="chip">{post.data.category}</span>
    {post.data.seriesTitle && <span class="muted">{post.data.seriesTitle}</span>}
  </div>
  <div>
    <h3><a class="post-card__title" href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
    <p class="post-card__summary">{post.data.description}</p>
  </div>
  <div class="card__footer post-card__footer">
    <div>
      <span class="muted">{formattedDate}</span>
      {post.data.tags.length > 0 && (
        <ul class="inline-tags">
          {post.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </div>
    <a class="post-card__link" href={`/blog/${post.id}/`}>Read entry →</a>
  </div>
</article>
