---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="section-heading">
  {eyebrow && (
    <div class="section-heading__header">
      <p class="eyebrow">{eyebrow}</p>
      <span class="section-heading__rule" aria-hidden="true"></span>
    </div>
  )}
  <h2>{title}</h2>
  {description && <p class="section-heading__lede">{description}</p>}
</div>
