---
import { currentFocus, profileCard, siteMeta } from '../data/site';
---

<details class="profile-menu" data-profile-menu>
  <summary class="profile-menu__toggle" aria-label="Open profile menu">
    <img
      class="profile-menu__avatar"
      src={profileCard.avatar}
      alt={`${siteMeta.shortTitle} profile avatar`}
      width="48"
      height="48"
      loading="eager"
      decoding="async"
    />
  </summary>

  <div class="profile-menu__popover" role="dialog" aria-label={`${siteMeta.shortTitle} profile card`}>
    <div class="profile-menu__hero">
      <img
        class="profile-menu__avatar profile-menu__avatar--large"
        src={profileCard.avatar}
        alt={`${siteMeta.shortTitle} profile avatar`}
        width="72"
        height="72"
        loading="eager"
        decoding="async"
      />
      <div class="profile-menu__identity">
        <p class="eyebrow">Profile</p>
        <h2>{siteMeta.shortTitle}</h2>
        <p class="profile-menu__role">{profileCard.role}</p>
      </div>
    </div>

    <div class="profile-menu__content">
      <p>{profileCard.shortBio}</p>
      <p class="profile-menu__detail">{profileCard.detailBio}</p>
    </div>

    <div class="profile-menu__panel">
      <p class="eyebrow">Current lanes</p>
      <ul class="utility-list profile-menu__list">
        {currentFocus.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="profile-menu__chips" aria-label="Profile highlights">
      {profileCard.highlights.map((item) => <span class="chip">{item}</span>)}
    </div>

    <div class="profile-menu__actions">
      <a class="button" href="/about">Detailed bio</a>
      <a class="button button--ghost" href={siteMeta.github} target="_blank" rel="noreferrer">GitHub ↗</a>
    </div>
  </div>
</details>
