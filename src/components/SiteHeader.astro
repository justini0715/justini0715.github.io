---
import ProfileMenu from './ProfileMenu.astro';
import { siteMeta } from '../data/site';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="site-shell__header" data-scroll-header>
  <div class="container site-nav">
    <a class="site-brand" href="/">
      <span class="site-brand__mark">42</span>
      <span class="site-brand__text">
        <strong>{siteMeta.shortTitle}</strong>
        <small>systems notes · project logs · static publishing</small>
      </span>
    </a>

    <div class="site-nav__group">
      <nav aria-label="Primary navigation" class="site-nav__primary">
        <ul class="site-nav__links">
          {siteMeta.nav.map((item) => (
            <li>
              <a aria-current={isActive(item.href) ? 'page' : undefined} class:list={{ 'is-active': isActive(item.href) }} href={item.href}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="site-nav__tools">
      <ProfileMenu />
    </div>
  </div>
</header>

<script is:inline>
  const header = document.querySelector('[data-scroll-header]');
  if (header) {
    const media = window.matchMedia('(max-width: 960px)');
    const profileMenu = header.querySelector('[data-profile-menu]');
    let lastY = window.scrollY;
    let ticking = false;

    const closeProfileMenu = () => {
      if (profileMenu instanceof HTMLDetailsElement) {
        profileMenu.open = false;
      }
    };

    const updateHeader = () => {
      const currentY = window.scrollY;

      if (!media.matches || currentY < 12) {
        header.classList.remove('is-hidden');
      } else if (currentY > lastY) {
        header.classList.add('is-hidden');
        closeProfileMenu();
      } else {
        header.classList.remove('is-hidden');
      }

      lastY = currentY;
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeader);
        ticking = true;
      }
    };

    document.addEventListener('click', (event) => {
      if (profileMenu instanceof HTMLDetailsElement && profileMenu.open && !profileMenu.contains(event.target)) {
        closeProfileMenu();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeProfileMenu();
      }
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', updateHeader);
    updateHeader();
  }
</script>
