---
import MainLayout from './MainLayout.astro';

interface Props {
  title?: string;
  description?: string;
  publishedTime?: string;
  updatedTime?: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, publishedTime, updatedTime, image, imageAlt } = Astro.props;
---

<MainLayout
  title={title}
  description={description}
  ogType="article"
  publishedTime={publishedTime}
  updatedTime={updatedTime}
  image={image}
  imageAlt={imageAlt}
>
  <slot />
</MainLayout>
