---
import MainLayout from './MainLayout.astro';

interface Props {
  title?: string;
  description?: string;
  publishedTime?: string;
  updatedTime?: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, publishedTime, updatedTime, image, imageAlt } = Astro.props;
const pathname = Astro.url.pathname;
const is42 = pathname.startsWith('/42/');
const isProject = pathname.startsWith('/projects/');
const parent = is42
  ? { href: '/42', label: '42 hub' }
  : isProject
    ? { href: '/projects', label: 'Projects' }
    : { href: '/blog', label: 'Technical blog' };
const articleKind = is42 ? '42 article' : isProject ? 'Project case' : 'Technical article';
---

<MainLayout
  title={title}
  description={description}
  ogType="article"
  publishedTime={publishedTime}
  updatedTime={updatedTime}
  image={image}
  imageAlt={imageAlt}
>
  <section class="layout-utility-bar">
    <div class="container article-context-bar">
      <a class="route-link-chip route-link-chip--back" href={parent.href}>← {parent.label}</a>
      <span class="article-context-bar__label">{articleKind}</span>
    </div>
  </section>
  <slot />
</MainLayout>
