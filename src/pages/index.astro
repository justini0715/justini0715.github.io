---
import MainLayout from '../layouts/MainLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import { focusAreas, siteMeta, strengths, writingPrinciples } from '../data/site';
import { getFeaturedProjects, getRecentPosts } from '../lib/content';

const featuredProjects = await getFeaturedProjects(3);
const recentPosts = await getRecentPosts(4);
---

<MainLayout title={siteMeta.title} description={siteMeta.description}>
  <section class="hero hero--home">
    <div class="container hero__grid">
      <div class="narrow-flow">
        <p class="eyebrow">Editorial systems notebook</p>
        <h1>Projects, posts, and 42 writeups edited into one deliberate developer journal.</h1>
        <p class="hero__lede">{siteMeta.intro}</p>
        <p class="hero-microcopy">{siteMeta.statusLine}</p>
        <div class="hero__actions">
          <a class="button" href="/projects">Read project cases</a>
          <a class="button button--ghost" href="/blog">Open the archive</a>
        </div>
      </div>

      <aside class="hero-note archive-panel">
        <div>
          <p class="eyebrow">Notebook focus</p>
          <h2>Built like a publication, not a landing page.</h2>
          <p class="page-kicker">
            The public site now separates working notes, project cases, and reading surfaces so each route carries a clearer role.
          </p>
        </div>
        <ul class="utility-list">
          {focusAreas.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container two-column">
      <article class="panel utility-panel">
        <p class="eyebrow">Notebook premise</p>
        <h2>Less generic dark-tech starter, more intentional project-and-writing home.</h2>
        <p>
          The site is tuned for developer readers who want implementation signal quickly: what the project was, what constraints mattered, and what changed after the first pass.
        </p>
      </article>

      <div class="feature-grid feature-grid--compact">
        {strengths.map((item) => (
          <article class="card stat-card">
            <p>{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Featured work"
        title="Repository-backed project cases with different technical textures"
        description="Infrastructure, graphics, concurrency, and algorithmic work now sit in a stronger card system instead of one repeated generic panel."
      />
      <div class="card-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionTitle
        eyebrow="Recent writing"
        title="Technical notes and 42 posts now read like entries in the same archive"
        description="The writing side keeps dates, tags, and series context visible without collapsing into the same presentation used for project work."
      />
      <div class="card-grid">
        {recentPosts.length ? (
          recentPosts.map((post) => <PostCard post={post} />)
        ) : (
          <article class="card empty-state">
            <h3>Launch posts are next</h3>
            <p>
              The structure already supports categories, tags, series ordering, and draft control. The next phase fills it with technical and 42 content.
            </p>
          </article>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Writing principles"
        title="Editorial rules for what makes it into the archive"
        description="Each entry should earn its place by clarifying a real implementation detail, decision, or lesson."
      />
      <div class="feature-grid">
        {writingPrinciples.map((item) => (
          <article class="card stat-card">
            <p>{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
