---
import LandingLayout from '../layouts/LandingLayout.astro';
import SplitHero from '../components/site/SplitHero.astro';
import LandingEntryCard from '../components/landing/LandingEntryCard.astro';
import TagChipList from '../components/site/TagChipList.astro';
import { currentFocus, profileCard, siteMeta } from '../data/site';
import { getFeaturedProjects, getProjectPath } from '../lib/content';

const [featuredProject] = await getFeaturedProjects(1);
const entryLanes = [
  {
    href: '/home',
    eyebrow: 'Personal hub',
    title: '나만의 홈',
    description: '내가 지금 뭘 만들고 있는지, 어떤 흐름으로 사이트를 쓰고 있는지 가장 먼저 보는 개인 허브.'
  },
  {
    href: '/projects',
    eyebrow: 'Project directory',
    title: 'Projects',
    description: '현재 진행하는 개발 프로젝트의 추이, 개요, 그리고 참고 자료를 프로젝트 단위로 정리한 공간.'
  },
  {
    href: '/42',
    eyebrow: '42 archive',
    title: '42',
    description: '42 과제들을 시리즈와 흐름 중심으로 모아둔 전용 허브. 과제별 맥락과 연결을 따라 읽기 좋게 구성.'
  },
  {
    href: '/blog',
    eyebrow: 'Study notebook',
    title: 'Blog',
    description: '알고리즘, 네트워크, 시스템 프로그래밍, 웹 개발 개념을 개발하면서 정리하는 학습 노트 아카이브.'
  }
] as const;
---

<LandingLayout
  title="Developer showcase landing"
  description="changwpa landing page for choosing between the personal home, project directory, 42 archive, and technical study blog."
>
  <SplitHero
    sectionClass="hero hero--landing"
    eyebrow="Developer showcase"
    title="개발자로서의 방향, 프로젝트, 42 기록, 기술 노트를 한눈에 고를 수 있는 시작점."
    description="이 페이지는 설명을 길게 늘어놓기보다, 지금 보고 싶은 영역으로 바로 들어가게 만드는 진입점이다."
    panelEyebrow="Quick read"
    panelItems={[
      '프로젝트를 먼저 보고 싶다면 Projects',
      '42 흐름을 보고 싶다면 42',
      '공부한 내용을 읽고 싶다면 Blog',
      '전체 요약과 현재 흐름은 Home'
    ]}
    panelClassName="hero-note landing-shell__note"
  >
    <Fragment slot="body">
      <p class="hero-microcopy">{siteMeta.statusLine}</p>
    </Fragment>
    <div slot="actions" class="hero__actions">
      <a class="button" href="/home">나만의 홈 열기</a>
      <a class="button button--ghost" href={siteMeta.github} target="_blank" rel="noreferrer" aria-label="Open GitHub profile in a new tab">GitHub ↗</a>
    </div>
  </SplitHero>

  <section class="section">
    <div class="container landing-overview-grid">
      <article class="panel landing-overview-card landing-overview-card--profile">
        <p class="eyebrow">Profile snapshot</p>
        <h2>{profileCard.role}</h2>
        <p>{profileCard.shortBio}</p>
        <TagChipList items={profileCard.highlights} />
      </article>

      <article class="panel landing-overview-card">
        <p class="eyebrow">Current focus</p>
        <ul class="utility-list">
          {currentFocus.slice(0, 3).map((item) => <li>{item}</li>)}
        </ul>
      </article>

      {featuredProject && (
        <a class="panel landing-overview-card landing-overview-card--feature" href={getProjectPath(featuredProject)}>
          <p class="eyebrow">Featured work</p>
          <h2>{featuredProject.data.title}</h2>
          <p>{featuredProject.data.highlight}</p>
          <span class="landing-card__link">케이스 보기 →</span>
        </a>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container landing-grid landing-grid--bento">
      {entryLanes.map((lane) => (
        <LandingEntryCard {...lane} />
      ))}
    </div>
  </section>
</LandingLayout>
