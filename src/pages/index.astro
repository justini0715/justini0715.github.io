---
import MainLayout from '../layouts/MainLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import { focusAreas, siteMeta, strengths, writingPrinciples } from '../data/site';
import { getFeaturedProjects, getRecentPosts } from '../lib/content';

const featuredProjects = await getFeaturedProjects(3);
const recentPosts = await getRecentPosts(4);
---

<MainLayout
  title="Developer portfolio, 42 projects, and technical blog"
  description="Developer portfolio and technical blog with 42 project writeups, systems programming notes, concurrency lessons, infrastructure work, and source-first Astro publishing."
>
  <section class="hero hero--home">
    <div class="container hero__grid">
      <div class="narrow-flow">
        <p class="eyebrow">Developer portfolio · 42 projects · technical blog</p>
        <h1>Developer portfolio, 42 project writeups, and technical posts in one source-first site.</h1>
        <p class="hero__lede">{siteMeta.intro}</p>
        <p class="hero-microcopy">{siteMeta.statusLine}</p>
        <div class="hero__actions">
          <a class="button" href="/projects">View projects</a>
          <a class="button button--ghost" href="/blog">Read technical posts</a>
        </div>
      </div>

      <aside class="hero-note archive-panel">
        <div>
          <p class="eyebrow">What you will find here</p>
          <h2>Case studies and writeups grounded in real repository work.</h2>
          <p class="page-kicker">
            Expect 42 assignments, C and systems programming notes, debugging lessons, infrastructure work, and source-first web publishing experiments.
          </p>
        </div>
        <ul class="utility-list">
          {focusAreas.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container two-column">
      <article class="panel utility-panel">
        <p class="eyebrow">What this site optimizes for</p>
        <h2>Fast context for developers who want technical signal, not filler.</h2>
        <p>
          Each page aims to answer the practical questions quickly: what the project was, what constraints mattered, what broke, and what changed after the first pass.
        </p>
      </article>

      <div class="feature-grid feature-grid--compact">
        {strengths.map((item) => (
          <article class="card stat-card">
            <p>{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Featured work"
        title="Repository-backed project cases with different technical textures"
        description="Infrastructure, graphics, concurrency, and algorithmic work presented as focused developer case studies rather than a flat repo grid."
      />
      <div class="card-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionTitle
        eyebrow="Recent writing"
        title="Technical posts and 42 writeups collected in one readable blog archive"
        description="Setup notes, retrospectives, debugging lessons, and assignment writeups stay connected without losing their own context."
      />
      <div class="card-grid">
        {recentPosts.length ? (
          recentPosts.map((post) => <PostCard post={post} />)
        ) : (
          <article class="card empty-state">
            <h3>Launch posts are next</h3>
            <p>
              The structure already supports categories, tags, series ordering, and draft control. The next phase fills it with technical and 42 content.
            </p>
          </article>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Writing principles"
        title="Editorial rules for what makes it into the archive"
        description="Each entry should earn its place by clarifying a real implementation detail, technical decision, or lesson."
      />
      <div class="feature-grid">
        {writingPrinciples.map((item) => (
          <article class="card stat-card">
            <p>{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
