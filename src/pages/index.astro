---
import MainLayout from '../layouts/MainLayout.astro';
import { siteMeta } from '../data/site';

const entryLanes = [
  {
    href: '/home',
    eyebrow: 'Personal hub',
    title: '나만의 홈',
    description: '내가 지금 뭘 만들고 있는지, 어떤 흐름으로 사이트를 쓰고 있는지 가장 먼저 보는 개인 허브.'
  },
  {
    href: '/projects',
    eyebrow: 'Project directory',
    title: 'Projects',
    description: '현재 진행하는 개발 프로젝트의 추이, 개요, 그리고 참고 자료를 프로젝트 단위로 정리한 공간.'
  },
  {
    href: '/42',
    eyebrow: '42 archive',
    title: '42',
    description: '42 과제들을 시리즈와 흐름 중심으로 모아둔 전용 허브. 과제별 맥락과 연결을 따라 읽기 좋게 구성.'
  },
  {
    href: '/blog',
    eyebrow: 'Study notebook',
    title: 'Blog',
    description: '알고리즘, 네트워크, 시스템 프로그래밍, 웹 개발 개념을 개발하면서 정리하는 학습 노트 아카이브.'
  }
] as const;
---

<MainLayout
  title="Developer showcase landing"
  description="changwpa landing page for choosing between the personal home, project directory, 42 archive, and technical study blog."
>
  <section class="hero hero--landing">
    <div class="container landing-shell">
      <div class="narrow-flow landing-shell__copy">
        <p class="eyebrow">Developer showcase</p>
        <h1>개발자로서의 방향, 프로젝트, 42 기록, 기술 노트를 한눈에 고를 수 있는 시작점.</h1>
        <p class="hero__lede">
          이 페이지는 설명을 길게 늘어놓기보다, 지금 보고 싶은 영역으로 바로 들어가게 만드는 진입점이다.
        </p>
        <p class="hero-microcopy">{siteMeta.statusLine}</p>
        <div class="hero__actions">
          <a class="button" href="/home">나만의 홈 열기</a>
          <a class="button button--ghost" href={siteMeta.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
      </div>

      <aside class="hero-note landing-shell__note">
        <p class="eyebrow">Quick read</p>
        <ul class="utility-list">
          <li>프로젝트를 먼저 보고 싶다면 Projects</li>
          <li>42 흐름을 보고 싶다면 42</li>
          <li>공부한 내용을 읽고 싶다면 Blog</li>
          <li>전체 요약과 현재 흐름은 Home</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container landing-grid">
      {entryLanes.map((lane) => (
        <a class="landing-card" href={lane.href}>
          <p class="eyebrow">{lane.eyebrow}</p>
          <h2>{lane.title}</h2>
          <p>{lane.description}</p>
          <span class="landing-card__link">열기 →</span>
        </a>
      ))}
    </div>
  </section>
</MainLayout>
