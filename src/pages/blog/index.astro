---
import MainLayout from '../../layouts/MainLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { seriesOverview } from '../../data/site';
import { getPublishedPosts } from '../../lib/content';

const posts = await getPublishedPosts();
---

<MainLayout title="Blog" description="Technical writing, project notes, and an assignment-by-assignment 42 series.">
  <section class="page-hero page-hero--blog">
    <div class="container hero__grid">
      <div class="narrow-flow">
        <p class="eyebrow">Archive index</p>
        <h1>A writing system built for shipping posts one-by-one.</h1>
        <p>
          The archive mixes technical notes, setup writeups, and 42 assignment posts. Categories, tags, and series ordering keep the flow close to a velog-style publishing habit without losing structure.
        </p>
        <p class="page-kicker">
          Index pages, series lanes, and individual reading surfaces now each carry a clearer role in the overall notebook.
        </p>
      </div>

      <aside class="panel archive-panel">
        <p class="eyebrow">Archive logic</p>
        <ul class="utility-list">
          <li>Posts stay readable as standalone entries.</li>
          <li>Series metadata keeps long 42 tracks connected.</li>
          <li>Tags remain visible without overwhelming the reading flow.</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="42 tracks"
        title="Series lanes for long-term writing"
        description="Each assignment can stand alone while still belonging to a larger learning arc."
      />
      <div class="feature-grid">
        {seriesOverview.map((series) => (
          <article class="card stat-card">
            <h3>{series.title}</h3>
            <p>{series.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionTitle
        eyebrow="Published posts"
        title="Launch archive"
        description="Technical posts and 42 entries share the same collection, but the card treatment is now explicitly tuned for journal-style browsing."
      />
      <div class="card-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</MainLayout>
