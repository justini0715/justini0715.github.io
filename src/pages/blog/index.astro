---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import SplitHero from '../../components/site/SplitHero.astro';
import ArchiveListItem from '../../components/site/ArchiveListItem.astro';
import { GENERAL_BLOG_CATEGORY_ORDER, getGeneralPosts, getPostPath, groupGeneralPostsByCategory } from '../../lib/content';

const posts = await getGeneralPosts();
const latestPosts = posts.slice(0, 3);
const groupedPosts = groupGeneralPostsByCategory(posts);
const categoryLabels = {
  devlog: 'Devlog',
  setup: 'Setup',
  retrospective: 'Retrospective',
  project: 'Project'
} as const;
const availableCategories = GENERAL_BLOG_CATEGORY_ORDER.filter((category) => groupedPosts.some((group) => group.category === category));
const formatDate = (value: Date) => new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(value);
---

<ArchiveLayout
  title="Technical blog"
  description="General technical blog archive for study notes, setup guides, retrospectives, and project-related technical writing outside the 42 track."
>
  <SplitHero
    sectionClass="page-hero page-hero--blog"
    eyebrow="Technical blog"
    title="개발하면서 공부한 일반 기술 노트를 모아두는 아카이브."
    description="이 페이지는 42 전용 허브와 분리된 일반 기술 블로그다. 알고리즘, 네트워크, 설정, 회고, 프로젝트성 기술 메모를 category별로 정리한다."
    panelEyebrow="Archive rules"
    panelItems={[
      '42 글은 여기 두지 않는다',
      'Latest posts에서 최근 노트를 먼저 본다',
      'All posts archive에서 category별로 다시 훑는다'
    ]}
    panelClassName="panel archive-panel"
  >
    <p slot="body" class="page-kicker">
      42 과제 글은 <a href="/42">42 hub</a>에서, 일반 기술 노트는 여기에서 읽는다.
    </p>
  </SplitHero>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Category chips"
        title="정적 카테고리 이동"
        description="상단 네비게이션을 늘리지 않고, 블로그 안에서 category별로 바로 이동할 수 있게 둔다."
      />
      <div class="archive-chip-row" aria-label="Blog category navigation">
        {availableCategories.map((category) => (
          <a class="route-link-chip" href={`#category-${category}`}>
            {categoryLabels[category]}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionTitle
        eyebrow="Latest posts"
        title="최근 일반 기술 글"
        description="가장 최근에 업데이트한 일반 기술 노트부터 먼저 읽을 수 있게 최근 글을 텍스트 중심으로 정리한다."
      />
      <div class="archive-post-list">
        {latestPosts.map((post) => (
          <ArchiveListItem
            href={getPostPath(post)}
            title={post.data.title}
            description={post.data.description}
            meta={[formatDate(post.data.pubDate), `category · ${post.data.category}`]}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="All posts archive"
        title="카테고리별 전체 아카이브"
        description="최신 글과 별개로, 전체 글을 카테고리 단위로 다시 읽을 수 있게 묶는다."
      />

      <div class="archive-group-list">
        {groupedPosts.map((group) => (
          <section id={`category-${group.category}`} class="archive-group-section">
            <div class="archive-group-section__head">
              <p class="eyebrow">{categoryLabels[group.category]}</p>
              <h3>{group.items.length} post{group.items.length > 1 ? 's' : ''}</h3>
            </div>

            <div class="archive-post-list">
              {group.items.map((post) => (
                <ArchiveListItem
                  href={getPostPath(post)}
                  title={post.data.title}
                  description={post.data.description}
                  meta={[formatDate(post.data.pubDate), `category · ${post.data.category}`]}
                  tags={post.data.tags}
                />
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</ArchiveLayout>
