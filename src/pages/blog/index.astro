---
import MainLayout from '../../layouts/MainLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { getGeneralPosts } from '../../lib/content';

const posts = await getGeneralPosts();
---

<MainLayout
  title="Technical blog"
  description="Technical blog archive for non-42 posts: debugging notes, setup guides, retrospectives, and source-first development writeups."
>
  <section class="page-hero page-hero--blog">
    <div class="container hero__grid">
      <div class="narrow-flow">
        <p class="eyebrow">Technical blog</p>
        <h1>Technical posts, setup notes, and retrospectives outside the 42 track.</h1>
        <p>
          This archive is now the general technical notebook: Astro rebuild notes, tooling writeups, debugging logs, setup guides, and retrospective posts that are not part of the dedicated 42 hub.
        </p>
        <p class="page-kicker">
          Looking for assignment-by-assignment 42 writeups instead? Visit <a href="/42">the 42 hub</a> for project-specific reading lanes.
        </p>
      </div>

      <aside class="panel archive-panel">
        <p class="eyebrow">What lives here</p>
        <ul class="utility-list">
          <li>Standalone technical posts with concrete implementation notes</li>
          <li>Setup, retrospective, and debugging entries outside the 42 curriculum</li>
          <li>Source-first workflow notes for the site and related tooling</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionTitle
        eyebrow="Published posts"
        title="Technical archive"
        description="Browse non-42 technical blog entries with dates, tags, and context visible at a glance."
      />
      <div class="card-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</MainLayout>
