---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import SplitHero from '../../components/site/SplitHero.astro';
import { getGeneralPosts } from '../../lib/content';

const posts = await getGeneralPosts();
---

<ArchiveLayout
  title="Technical blog"
  description="Technical blog archive for non-42 posts: debugging notes, setup guides, retrospectives, and source-first development writeups."
>
  <SplitHero
    sectionClass="page-hero page-hero--blog"
    eyebrow="Technical blog"
    title="Technical posts, setup notes, and retrospectives outside the 42 track."
    description="This archive is now the general technical notebook: Astro rebuild notes, tooling writeups, debugging logs, setup guides, and retrospective posts that are not part of the dedicated 42 hub."
    panelEyebrow="What lives here"
    panelItems={[
      'Standalone technical posts with concrete implementation notes',
      'Setup, retrospective, and debugging entries outside the 42 curriculum',
      'Source-first workflow notes for the site and related tooling'
    ]}
    panelClassName="panel archive-panel"
  >
    <p slot="body" class="page-kicker">
      Looking for assignment-by-assignment 42 writeups instead? Visit <a href="/42">the 42 hub</a> for project-specific reading lanes.
    </p>
  </SplitHero>

  <section class="section section--tint">
    <div class="container">
      <SectionTitle
        eyebrow="Published posts"
        title="Technical archive"
        description="Browse non-42 technical blog entries with dates, tags, and context visible at a glance."
      />
      <div class="card-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</ArchiveLayout>
