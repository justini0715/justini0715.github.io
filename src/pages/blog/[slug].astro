---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { getAdjacentSeriesPosts, getPublishedPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.filter((post) => !post.data.draft).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const allPosts = await getPublishedPosts();
const { previous, next } = getAdjacentSeriesPosts(allPosts, post);
const formattedDate = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(post.data.pubDate);
---

<MainLayout title={post.data.title} description={post.data.description} ogType="article" publishedTime={post.data.pubDate.toISOString()}>
  <section class="page-hero page-hero--post">
    <div class="container hero__grid">
      <div class="reading-surface narrow-flow">
        <p class="eyebrow">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <div class="post-meta-row">
          <span class="chip">{formattedDate}</span>
          {post.data.seriesTitle && <span class="muted">Series · {post.data.seriesTitle}</span>}
        </div>
      </div>

      <aside class="panel utility-panel">
        <p class="eyebrow">Reading notes</p>
        <p class="meta-note">This route shifts into reading mode with quieter chrome, visible metadata, and enough context to keep longer series navigable.</p>
        {post.data.tags.length > 0 && (
          <ul class="inline-tags">
            {post.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )}
      </aside>
    </div>
  </section>

  <article class="section">
    <div class="container prose-shell">
      <Content />
    </div>
  </article>

  {(previous || next) && (
    <section class="section section--tint">
      <div class="container series-nav">
        {previous ? (
          <a class="series-card" href={`/blog/${previous.id}/`}>
            <p class="eyebrow">Previous in series</p>
            <strong>{previous.data.title}</strong>
            <span class="muted">Continue backward through the assignment log.</span>
          </a>
        ) : <div class="series-nav__empty"></div>}
        {next ? (
          <a class="series-card" href={`/blog/${next.id}/`}>
            <p class="eyebrow">Next in series</p>
            <strong>{next.data.title}</strong>
            <span class="muted">Move forward to the next linked writeup.</span>
          </a>
        ) : <div class="series-nav__empty"></div>}
      </div>
    </section>
  )}
</MainLayout>
