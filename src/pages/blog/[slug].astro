---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import TechnicalArticleMetaPanel from '../../components/blog/TechnicalArticleMetaPanel.astro';
import { getAdjacentSeriesPosts, getGeneralPosts, getPostPath } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getGeneralPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const allPosts = await getGeneralPosts();
const { previous, next } = getAdjacentSeriesPosts(allPosts, post);
const formattedDate = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(post.data.pubDate);
const seriesContext = post.data.seriesTitle
  ? `${post.data.seriesTitle} 시리즈의 한 글로, 같은 학습 흐름 안에서 앞뒤 글과 연결됩니다.`
  : `${post.data.category} 카테고리에서 읽을 수 있는 독립적인 기술 글입니다.`;
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  publishedTime={post.data.pubDate.toISOString()}
  updatedTime={post.data.updatedDate?.toISOString()}
>
  <section class="page-hero page-hero--post">
    <div class="container hero__grid">
      <div class="reading-surface narrow-flow">
        <p class="eyebrow">Technical blog</p>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <p class="page-kicker">일반 기술 글은 학습/정리 중심의 노트로 다루며, 프로젝트 과제 글보다 더 가볍고 개념 중심의 읽기 흐름을 유지한다.</p>
      </div>

      <TechnicalArticleMetaPanel post={post} formattedDate={formattedDate} seriesContext={seriesContext} />
    </div>
  </section>

  <article class="section">
    <div class="container prose-shell">
      <Content />
    </div>
  </article>

  {(previous || next) && (
    <section class="section section--tint">
      <div class="container series-nav">
        {previous ? (
          <a class="series-card" href={getPostPath(previous)}>
            <p class="eyebrow">Previous in series</p>
            <strong>{previous.data.title}</strong>
            <span class="muted">Continue backward through the linked notes.</span>
          </a>
        ) : <div class="series-nav__empty"></div>}
        {next ? (
          <a class="series-card" href={getPostPath(next)}>
            <p class="eyebrow">Next in series</p>
            <strong>{next.data.title}</strong>
            <span class="muted">Move forward to the next linked writeup.</span>
          </a>
        ) : <div class="series-nav__empty"></div>}
      </div>
    </section>
  )}
</ArticleLayout>
