---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import TechnicalArticleMetaPanel from '../../components/blog/TechnicalArticleMetaPanel.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import ArchiveListItem from '../../components/site/ArchiveListItem.astro';
import MetaRow from '../../components/site/MetaRow.astro';
import TagChipList from '../../components/site/TagChipList.astro';
import { getAdjacentSeriesPosts, getGeneralPosts, getPostPath, getRelatedGeneralPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getGeneralPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const allPosts = await getGeneralPosts();
const { previous, next } = getAdjacentSeriesPosts(allPosts, post);
const relatedPosts = !previous && !next ? getRelatedGeneralPosts(allPosts, post, 2) : [];
const formattedDate = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(post.data.pubDate);
const formattedUpdatedDate = post.data.updatedDate
  ? new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(post.data.updatedDate)
  : undefined;
const seriesContext = post.data.seriesTitle
  ? `${post.data.seriesTitle} 시리즈의 한 글로, 같은 흐름 안에서 앞뒤 글과 연결됩니다.`
  : `${post.data.category} 카테고리에서 읽는 독립적인 기술 글입니다.`;
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  publishedTime={post.data.pubDate.toISOString()}
  updatedTime={post.data.updatedDate?.toISOString()}
>
  <section class="page-hero page-hero--post">
    <div class="container hero__grid">
      <div class="reading-surface narrow-flow">
        <p class="eyebrow">Technical blog</p>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <MetaRow items={[formattedDate, formattedUpdatedDate ? `updated · ${formattedUpdatedDate}` : '', `category · ${post.data.category}`]} />
        <TagChipList items={post.data.tags} />
      </div>

      <TechnicalArticleMetaPanel
        post={post}
        formattedDate={formattedDate}
        formattedUpdatedDate={formattedUpdatedDate}
        seriesContext={seriesContext}
      />
    </div>
  </section>

  <article class="section">
    <div class="container prose-shell">
      <Content />
    </div>
  </article>

  {(previous || next) && (
    <section class="section section--tint">
      <div class="container series-nav">
        {previous ? (
          <a class="series-card" href={getPostPath(previous)}>
            <p class="eyebrow">Previous in series</p>
            <strong>{previous.data.title}</strong>
            <span class="muted">Continue backward through the linked notes.</span>
          </a>
        ) : <div class="series-nav__empty"></div>}
        {next ? (
          <a class="series-card" href={getPostPath(next)}>
            <p class="eyebrow">Next in series</p>
            <strong>{next.data.title}</strong>
            <span class="muted">Move forward to the next linked writeup.</span>
          </a>
        ) : <div class="series-nav__empty"></div>}
      </div>
    </section>
  )}

  {!previous && !next && relatedPosts.length > 0 && (
    <section class="section section--tint">
      <div class="container">
        <SectionTitle
          eyebrow="Related posts"
          title="같이 읽으면 좋은 일반 기술 글"
          description="같은 category나 태그를 공유하는 글을 우선으로 골라 이어 읽을 수 있게 한다."
        />
        <div class="archive-post-list">
          {relatedPosts.map((relatedPost) => {
            const relatedDate = new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(relatedPost.data.pubDate);
            return (
              <ArchiveListItem
                href={getPostPath(relatedPost)}
                title={relatedPost.data.title}
                description={relatedPost.data.description}
                meta={[relatedDate, `category · ${relatedPost.data.category}`]}
                tags={relatedPost.data.tags}
              />
            );
          })}
        </div>
      </div>
    </section>
  )}
</ArticleLayout>
