---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import FortyTwoMetaPanel from '../../components/forty-two/FortyTwoMetaPanel.astro';
import { get42Posts, getAdjacentSeriesPosts, getPostPath } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await get42Posts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const allPosts = await get42Posts();
const { previous, next } = getAdjacentSeriesPosts(allPosts, post);
const formattedDate = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(post.data.pubDate);
const seriesContext = post.data.seriesTitle
  ? `${post.data.seriesTitle} 시리즈의 한 글로, 같은 학습 흐름 안에서 앞뒤 글과 연결됩니다.`
  : '42 카테고리에서 읽을 수 있는 독립적인 과제 기록입니다.';
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  publishedTime={post.data.pubDate.toISOString()}
  updatedTime={post.data.updatedDate?.toISOString()}
>
  <section class="page-hero page-hero--post">
    <div class="container hero__grid">
      <div class="reading-surface narrow-flow">
        <p class="eyebrow">42 hub</p>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <p class="page-kicker">42 전용 글은 시리즈, 순서, 난이도, 전후 맥락을 함께 보여줘서 일반 기술 글보다 프로젝트 흐름을 더 강하게 드러낸다.</p>
      </div>

      <FortyTwoMetaPanel post={post as any} formattedDate={formattedDate} seriesContext={seriesContext} />
    </div>
  </section>

  <article class="section">
    <div class="container prose-shell">
      <Content />
    </div>
  </article>

  {(previous || next) && (
    <section class="section section--tint">
      <div class="container series-nav">
        {previous ? (
          <a class="series-card" href={getPostPath(previous)}>
            <p class="eyebrow">Previous in series</p>
            <strong>{previous.data.title}</strong>
            <span class="muted">Continue backward through the assignment log.</span>
          </a>
        ) : <div class="series-nav__empty"></div>}
        {next ? (
          <a class="series-card" href={getPostPath(next)}>
            <p class="eyebrow">Next in series</p>
            <strong>{next.data.title}</strong>
            <span class="muted">Move forward to the next linked writeup.</span>
          </a>
        ) : <div class="series-nav__empty"></div>}
      </div>
    </section>
  )}
</ArticleLayout>
