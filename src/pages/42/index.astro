---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import SplitHero from '../../components/site/SplitHero.astro';
import ArchiveListItem from '../../components/site/ArchiveListItem.astro';
import { seriesOverview } from '../../data/site';
import { get42Posts, getPostPath, groupPostsBySeries } from '../../lib/content';

const posts = await get42Posts();
const seriesGroups = groupPostsBySeries(posts);
const recentPosts = posts.slice(0, 3);
const formatDate = (value: Date) => new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(value);
---

<ArchiveLayout
  title="42 hub"
  description="Dedicated 42 archive with series lanes, read-in-order links, and recent assignment writeups."
>
  <SplitHero
    sectionClass="page-hero page-hero--blog"
    eyebrow="42 hub"
    title="42 과제 흐름을 전용 허브로 분리해 읽는 아카이브."
    description="이 경로는 42 글만 모아두는 허브다. 일반 기술 블로그와 합치지 않고, 시리즈와 읽는 순서를 중심으로 정리한다."
    panelEyebrow="Hub structure"
    panelItems={[
      'Series lanes로 42 트랙을 나눈다',
      'Read in order에서 같은 흐름의 순서를 따라간다',
      'Recent entries에서 최근 과제 기록을 바로 연다'
    ]}
    panelClassName="panel archive-panel"
  >
    <p slot="body" class="page-kicker">
      일반 기술 노트와 회고는 <a href="/blog">Blog</a>에서, 42 과제 흐름은 여기에서 읽는다.
    </p>
  </SplitHero>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Series lanes"
        title="42 트랙별 읽기 축"
        description="시스템, 그래픽, 인프라 같은 맥락으로 묶어서 각 과제가 어디에 속하는지 먼저 보여준다."
      />
      <div class="feature-grid feature-grid--compact">
        {seriesOverview.map((series) => (
          <article class="card stat-card">
            <h3>{series.title}</h3>
            <p>{series.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionTitle
        eyebrow="Read in order"
        title="시리즈 순서로 이어 읽기"
        description="같은 시리즈 안의 과제가 어떤 순서로 쌓였는지부터 이해할 수 있게 한다."
      />

      <div class="hub-lane-grid">
        {seriesGroups.map((group) => (
          <section class="panel hub-lane-panel">
            <div class="hub-lane-panel__head">
              <p class="eyebrow">{group.title}</p>
              <h3>{group.items.length} {group.items.length > 1 ? 'entries' : 'entry'}</h3>
            </div>
            <div class="hub-stack-cluster">
              {group.items.map((post) => (
                <a class="hub-project-link" href={`/42/${post.id}/`}>
                  <strong>{post.data.seriesOrder ? `${post.data.seriesOrder}. ` : ''}{post.data.title}</strong>
                  <span>{post.data.description}</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Recent 42 entries"
        title="최근 과제 기록"
        description="지금 막 추가되거나 업데이트된 42 글부터 바로 읽을 수 있게 최근 항목만 먼저 보여준다."
      />
      <div class="archive-post-list">
        {recentPosts.map((post) => (
          <ArchiveListItem
            href={getPostPath(post)}
            title={post.data.title}
            description={post.data.description}
            meta={[
              formatDate(post.data.pubDate),
              post.data.seriesTitle ? `series · ${post.data.seriesTitle}` : ''
            ]}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </section>
</ArchiveLayout>
