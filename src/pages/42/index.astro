---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import SplitHero from '../../components/site/SplitHero.astro';
import ArchiveListItem from '../../components/site/ArchiveListItem.astro';
import { fortyTwoCircleOverview } from '../../data/site';
import { get42Posts, getPostPath, group42PostsByCircle } from '../../lib/content';

const posts = await get42Posts();
const circleGroups = group42PostsByCircle(posts);
const recentPosts = posts.slice(0, 3);
const formatDate = (value: Date) => new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(value);
---

<ArchiveLayout
  title="42 hub"
  description="Dedicated 42 archive organized around the public 42 cursus circle progression."
>
  <SplitHero
    sectionClass="page-hero page-hero--blog"
    eyebrow="42 hub"
    title="42 과제를 복잡한 주제 축 대신 서클 기준으로 다시 정리한 아카이브."
    description="이 경로는 42 글만 모아두는 허브다. 공개 Common Core 자료에서 쓰는 circle 흐름을 기준으로 다시 묶고, 현재 로컬 workspace에 있는 과제만 남겨서 단순하게 본다."
    panelEyebrow="Hub structure"
    panelItems={[
      'Circle 0부터 Circle 5까지 바깥으로 확장되는 흐름으로 읽는다',
      '같은 circle 안에서는 현재 로컬 archive 기준으로 읽기 순서를 잡는다',
      '캠퍼스별 elective 차이나 placeholder 상태는 각 글 본문에서 명시한다'
    ]}
    panelClassName="panel archive-panel"
  >
    <p slot="body" class="page-kicker">
      일반 기술 노트와 회고는 <a href="/blog">Blog</a>에서, 42 Common Core 흐름은 여기에서 읽는다.
    </p>
  </SplitHero>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Circle overview"
        title="42 Cursus를 서클 단위로 단순화"
        description="공개 42 cursus 자료에서 쓰는 concentric circle 구조를 기준으로, 현재 로컬 archive에 있는 과제만 Circle 0~5로 다시 배치했다."
      />
      <div class="feature-grid feature-grid--compact">
        {fortyTwoCircleOverview.map((circle) => (
          <article class="card stat-card">
            <h3>{circle.title}</h3>
            <p>{circle.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionTitle
        eyebrow="By circle"
        title="서클별로 이어 읽기"
        description="각 circle 안에서 현재 보유한 과제 기록을 순서대로 묶었다. 공식 cursus는 캠퍼스/기수에 따라 조금씩 다를 수 있어, local archive 기준 설명을 함께 붙인다."
      />

      <div class="hub-lane-grid">
        {circleGroups.map((group) => (
          <section class="panel hub-lane-panel">
            <div class="hub-lane-panel__head">
              <p class="eyebrow">{group.title}</p>
              <h3>{group.items.length} {group.items.length > 1 ? 'projects' : 'project'}</h3>
            </div>
            <div class="hub-stack-cluster">
              {group.items.map((post) => (
                <a class="hub-project-link" href={`/42/${post.id}/`}>
                  <strong>{post.data.seriesOrder ? `${post.data.seriesOrder}. ` : ''}{post.data.title}</strong>
                  <span>{post.data.description}</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Recent 42 entries"
        title="최근 과제 기록"
        description="서클 구성이 바뀌어도 최근에 정리한 과제부터 바로 열 수 있게 최신 항목은 따로 보여준다."
      />
      <div class="archive-post-list">
        {recentPosts.map((post) => (
          <ArchiveListItem
            href={getPostPath(post)}
            title={post.data.title}
            description={post.data.description}
            meta={[
              formatDate(post.data.pubDate),
              post.data.seriesTitle ? `circle · ${post.data.seriesTitle}` : ''
            ]}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </section>
</ArchiveLayout>
