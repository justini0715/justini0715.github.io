---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import SplitHero from '../../components/site/SplitHero.astro';
import { getFeaturedProjects, getProjects, groupProjectsByState } from '../../lib/content';

const projects = await getProjects();
const featuredProjects = await getFeaturedProjects(2);
const projectStates = groupProjectsByState(projects);
const stateLabels = {
  active: 'Active',
  stable: 'Stable',
  archived: 'Archived',
  planned: 'Planned'
} as const;
---

<ArchiveLayout
  title="Projects and case studies"
  description="Project index for changwpa with selected work, project states, and full repository-backed case studies."
>
  <SplitHero
    sectionClass="page-hero page-hero--projects"
    eyebrow="Projects"
    title="프로젝트의 추이, 상태, 케이스 스터디를 한 곳에서 읽는 인덱스."
    description="이 페이지는 프로젝트를 홍보하기보다, 어떤 작업을 했고 지금 어떤 상태인지 빠르게 파악하는 인덱스 역할을 한다."
    kicker="각 카드는 title, description, stack, 상태, highlight, repository 접근을 기준으로 정리한다."
    panelEyebrow="How to read"
    panelItems={[
      'Selected work에서 대표 케이스를 먼저 본다',
      'Project states에서 active/stable/archived/planned를 구분한다',
      'All projects grid에서 전체 목록을 훑는다'
    ]}
    panelClassName="panel archive-panel"
  />

  <section class="section">
    <div class="container projects-bento-grid">
      {featuredProjects.map((project) => (
        <div class="projects-bento-grid__item projects-bento-grid__item--feature">
          <ProjectCard project={project} />
        </div>
      ))}

      <article class="panel projects-bento-grid__item projects-bento-grid__item--states-overview">
        <p class="eyebrow">Project states</p>
        <h2>상태 요약</h2>
        <div class="projects-state-summary">
          {projectStates.map((group) => (
            <div class="projects-state-summary__item">
              <strong>{stateLabels[group.state]}</strong>
              <span>{group.items.length}</span>
            </div>
          ))}
        </div>
        <p class="meta-note">active → stable → archived → planned 순서로 읽으면 지금 손볼 프로젝트가 더 빨리 보인다.</p>
      </article>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionTitle
        eyebrow="Project states"
        title="현재 상태 기준으로 보는 프로젝트 판"
        description="대표 카드와 별개로, 상태별로 다시 훑을 수 있게 리스트를 유지한다."
      />

      <div class="hub-lane-grid">
        {projectStates.map((group) => (
          <section class="panel hub-lane-panel">
            <div class="hub-lane-panel__head">
              <p class="eyebrow">{stateLabels[group.state]}</p>
              <h3>{group.items.length} project{group.items.length > 1 ? 's' : ''}</h3>
            </div>
            <div class="hub-stack-cluster">
              {group.items.map((project) => (
                <a class="hub-project-link" href={`/projects/${project.id}/`}>
                  <strong>{project.data.title}</strong>
                  <span>{project.data.focus ?? project.data.highlight}</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="All projects"
        title="전체 프로젝트 목록"
        description="각 카드에서 바로 케이스 상세나 repository로 들어갈 수 있게 유지한다."
      />
      <div class="card-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</ArchiveLayout>
