---
import MainLayout from '../../layouts/MainLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<MainLayout title="Projects" description="Structured project entries for 42 work and other development projects.">
  <section class="page-hero page-hero--projects">
    <div class="container hero__grid">
      <div class="narrow-flow">
        <p class="eyebrow">Project directory</p>
        <h1>Meaningful entries instead of a flat repository list.</h1>
        <p>
          The launch set is built from existing repositories with clear technical angles: infrastructure, graphics, concurrency, and constrained algorithm design.
        </p>
        <p class="page-kicker">
          Each card emphasizes the scope, signal, and one highlight worth remembering later.
        </p>
      </div>

      <aside class="panel archive-panel">
        <p class="eyebrow">What each entry tracks</p>
        <ul class="utility-list">
          <li>Project role and current status</li>
          <li>One implementation highlight instead of generic marketing copy</li>
          <li>Stack markers plus repository access</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Selected work"
        title="Repository-backed case studies"
        description="These cards now behave like project cases with clearer hierarchy between summary, highlight, stack, and links."
      />
      <div class="card-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</MainLayout>
