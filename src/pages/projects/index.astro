---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import SplitHero from '../../components/site/SplitHero.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<ArchiveLayout
  title="Projects and 42 case studies"
  description="Developer portfolio projects and 42 case studies covering infrastructure, graphics, concurrency, algorithms, and source-first engineering work."
>
  <SplitHero
    sectionClass="page-hero page-hero--projects"
    eyebrow="Developer projects · 42 case studies"
    title="Project case studies across infrastructure, graphics, concurrency, and algorithms."
    description="This directory is built from existing repositories and shaped for technical readers: what the project covered, which constraints mattered, and why the implementation is worth reviewing."
    kicker="Expect 42 projects, Docker and web infrastructure work, graphics experiments, and operation-constrained algorithm cases."
    panelEyebrow="What each case tracks"
    panelItems={[
      'Project role and current status',
      'One implementation highlight instead of generic marketing copy',
      'Stack markers plus repository access'
    ]}
    panelClassName="panel archive-panel"
  />

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Selected work"
        title="Repository-backed case studies"
        description="Each entry focuses on the technical angle that makes the repository useful to a reviewer, teammate, or future self."
      />
      <div class="card-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</ArchiveLayout>
