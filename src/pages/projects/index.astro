---
import MainLayout from '../../layouts/MainLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<MainLayout title="Projects" description="Structured project entries for 42 work and other development projects.">
  <section class="page-hero">
    <div class="container narrow-flow">
      <p class="eyebrow">Projects</p>
      <h1>Meaningful entries instead of a flat repository list.</h1>
      <p>
        The launch set is built from existing repositories with clear technical angles: infrastructure, graphics, concurrency, and constrained algorithm design.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Selected work"
        title="Repository-backed case studies"
        description="Each card focuses on scope, stack, and one high-signal implementation highlight drawn from the current project materials."
      />
      <div class="card-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</MainLayout>
