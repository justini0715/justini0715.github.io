---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import WritingStudioApp from '../components/WritingStudioApp.astro';

const studioEnabled = import.meta.env.DEV;
const initialBlogPosts = (await getCollection('blog')).map((post) => ({
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate.toISOString().slice(0, 10),
  updatedDate: post.data.updatedDate?.toISOString().slice(0, 10) ?? '',
  category: post.data.category,
  tags: post.data.tags,
  series: post.data.series ?? '',
  seriesTitle: post.data.seriesTitle ?? '',
  seriesOrder: post.data.seriesOrder ? String(post.data.seriesOrder) : '',
  difficulty: post.data.difficulty ?? '',
  featured: post.data.featured,
  draft: post.data.draft,
  body: post.body ?? ''
}));
---

<MainLayout
  title="Writing Studio"
  description="No-backend personal writing UI for creating and editing Markdown posts in the Astro blog."
  noindex={true}
>
  <section class="page-hero studio-page-hero">
    <div class="container studio-intro-shell">
      <div class="studio-intro-copy">
        <p class="eyebrow">Local writing desk</p>
        <h1>Writing Studio</h1>
        <p class="studio-intro-lede">제목, 설명, 본문이 먼저 보이고 라이브러리와 설정은 뒤로 물러난 로컬 전용 원고 데스크입니다.</p>
        <ol class="studio-intro-steps">
          <li><strong>1.</strong> <code>npm run dev</code> 실행</li>
          <li><strong>2.</strong> localhost 주소 뒤에 <code>/studio</code> 접속</li>
          <li><strong>3.</strong> 필요할 때만 라이브러리·오른쪽 패널 열기</li>
          <li><strong>4.</strong> 폴더 연결 후 저장</li>
        </ol>
      </div>
      <pre class="studio-intro-code"><code>cd /home/iostream/changwpa-site-manual/work/justini0715.github.io
npm run dev

# 예: http://127.0.0.1:4328/studio
# 글 파일 위치: src/content/blog/*.md</code></pre>
    </div>
  </section>

  {studioEnabled ? (
    <WritingStudioApp initialPosts={initialBlogPosts} />
  ) : (
    <section class="section studio-locked-page">
      <div class="container studio-locked-page__card">
        <p class="eyebrow">Production lock</p>
        <h2>배포본에서는 editor를 싣지 않습니다.</h2>
        <p>
          `/studio`는 개인 로컬 작성 도구라서, 프로덕션 빌드에서는 실제 editor UI와 파일 쓰기 로직이 포함되지 않습니다.
        </p>
        <ol>
          <li>로컬 레포에서 <code>npm run dev</code> 실행</li>
          <li>터미널에 표시된 localhost 주소 뒤에 <code>/studio</code> 접속</li>
          <li>Chrome / Edge / Brave 데스크톱에서 레포 폴더 연결</li>
        </ol>
        <div class="studio-locked-page__actions">
          <a class="button" href="/blog">블로그 보기</a>
          <a class="button button--ghost" href="/">홈으로</a>
        </div>
      </div>
    </section>
  )}
</MainLayout>

<style>
  .studio-page-hero {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .studio-intro-shell {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1.3fr) minmax(300px, 0.9fr);
    align-items: start;
  }

  .studio-intro-copy {
    display: grid;
    gap: 0.85rem;
  }

  .studio-intro-lede {
    max-width: 60ch;
    color: var(--text);
  }

  .studio-intro-steps {
    display: grid;
    gap: 0.55rem;
    padding-left: 0;
    list-style: none;
  }

  .studio-intro-steps li {
    display: flex;
    gap: 0.6rem;
    color: var(--text);
  }

  .studio-intro-code {
    margin: 0;
    overflow: auto;
    padding: 1rem;
    border-radius: 20px;
    background: rgba(10, 10, 14, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #edf2ff;
  }

  .studio-locked-page__card {
    display: grid;
    gap: 1rem;
    max-width: 760px;
    padding: 2rem;
    border-radius: 28px;
    background: rgba(10, 14, 24, 0.86);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: var(--shadow);
  }

  .studio-locked-page__card ol {
    padding-left: 1.2rem;
    list-style: decimal;
    color: var(--muted);
  }

  .studio-locked-page__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .studio-intro-shell {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .studio-intro-code { padding: 0.9rem; }
  }
</style>
