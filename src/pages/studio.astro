---
import MainLayout from '../layouts/MainLayout.astro';
import { readdir, readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import WritingStudioApp from '../components/WritingStudioApp.astro';
import { parsePostFile, type StudioCollectionKey } from '../lib/studio/blogStudio';

const studioEnabled = import.meta.env.DEV;

async function loadStudioSeed() {
  const directories: { key: StudioCollectionKey; path: string }[] = [
    { key: 'blog', path: resolve('src/content/blog') },
    { key: 'forty-two', path: resolve('src/content/forty-two') }
  ];
  const posts = [];

  for (const directory of directories) {
    try {
      const entries = await readdir(directory.path, { withFileTypes: true });
      for (const entry of entries) {
        if (!entry.isFile() || !entry.name.endsWith('.md') || entry.name === '.gitkeep') continue;
        const raw = await readFile(resolve(directory.path, entry.name), 'utf-8');
        posts.push(parsePostFile(entry.name, raw, directory.key));
      }
    } catch {
      // Missing collection directories are okay in local studio mode.
    }
  }

  return posts
    .sort((left, right) => right.pubDate.localeCompare(left.pubDate) || left.title.localeCompare(right.title))
    .map((post) => ({
      collection: post.collection,
      slug: post.slug,
      title: post.title,
      description: post.description,
      pubDate: post.pubDate,
      updatedDate: post.updatedDate,
      category: post.category,
      tags: post.tags,
      series: post.series,
      seriesTitle: post.seriesTitle,
      seriesOrder: post.seriesOrder,
      difficulty: post.difficulty,
      featured: post.featured,
      draft: post.draft,
      body: post.body
    }));
}

const initialBlogPosts = studioEnabled ? await loadStudioSeed() : [];
---

<MainLayout
  title="Writing Studio"
  description="No-backend personal writing UI for creating and editing Markdown posts in the Astro blog."
  noindex={true}
>
  {studioEnabled && (
    <section class="section studio-dev-note">
      <div class="container">
        <details class="studio-dev-note__details">
          <summary class="studio-dev-note__summary">
            <span class="eyebrow">Local writing desk</span>
            <strong>로컬 열기 안내</strong>
            <small>제목 → 설명 → 본문부터 쓰고, 설정은 나중에 여세요.</small>
          </summary>
          <div class="studio-dev-note__body">
            <ol class="studio-intro-steps">
              <li><strong>1.</strong> <code>npm run dev</code> 실행</li>
              <li><strong>2.</strong> localhost 주소 뒤에 <code>/studio</code> 접속</li>
              <li><strong>3.</strong> 필요할 때만 라이브러리·오른쪽 패널 열기</li>
              <li><strong>4.</strong> 폴더 연결 후 저장</li>
            </ol>
            <pre class="studio-intro-code"><code>cd /home/iostream/changwpa-site-manual/work/justini0715.github.io
npm run dev

# 예: http://127.0.0.1:4328/studio
# 일반 글: src/content/blog/*.md
# 42 글: src/content/forty-two/*.md</code></pre>
          </div>
        </details>
      </div>
    </section>
  )}

  {studioEnabled ? (
    <WritingStudioApp initialPosts={initialBlogPosts} />
  ) : (
    <section class="section studio-locked-page">
      <div class="container studio-locked-page__card">
        <p class="eyebrow">Production lock</p>
        <h2>배포본에서는 editor를 싣지 않습니다.</h2>
        <p>
          `/studio`는 개인 로컬 작성 도구라서, 프로덕션 빌드에서는 실제 editor UI와 파일 쓰기 로직이 포함되지 않습니다.
        </p>
        <ol>
          <li>로컬 레포에서 <code>npm run dev</code> 실행</li>
          <li>터미널에 표시된 localhost 주소 뒤에 <code>/studio</code> 접속</li>
          <li>Chrome / Edge / Brave 데스크톱에서 레포 폴더 연결</li>
        </ol>
        <div class="studio-locked-page__actions">
          <a class="button" href="/blog">블로그 보기</a>
          <a class="button button--ghost" href="/">홈으로</a>
        </div>
      </div>
    </section>
  )}
</MainLayout>

<style>
  .studio-dev-note {
    padding-top: 0.6rem;
  }

  .studio-dev-note__details {
    display: grid;
    gap: 0.85rem;
    padding: 0.95rem 1rem;
    border-radius: 22px;
    background: rgba(12, 14, 19, 0.76);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .studio-dev-note__summary {
    display: grid;
    gap: 0.35rem;
    cursor: pointer;
    list-style: none;
  }

  .studio-dev-note__summary::-webkit-details-marker {
    display: none;
  }

  .studio-dev-note__summary strong {
    color: var(--text);
    font-size: 1rem;
  }

  .studio-dev-note__summary small {
    color: var(--muted);
  }

  .studio-dev-note__body {
    display: grid;
    gap: 0.85rem;
    padding-top: 0.2rem;
  }

  .studio-intro-steps {
    display: grid;
    gap: 0.55rem;
    padding-left: 0;
    list-style: none;
  }

  .studio-intro-steps li {
    display: flex;
    gap: 0.6rem;
    color: var(--text);
  }

  .studio-intro-code {
    margin: 0;
    overflow: auto;
    padding: 0.95rem;
    border-radius: 20px;
    background: rgba(10, 10, 14, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #edf2ff;
  }

  .studio-locked-page__card {
    display: grid;
    gap: 1rem;
    max-width: 760px;
    padding: 2rem;
    border-radius: 28px;
    background: rgba(10, 14, 24, 0.86);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: var(--shadow);
  }

  .studio-locked-page__card ol {
    padding-left: 1.2rem;
    list-style: decimal;
    color: var(--muted);
  }

  .studio-locked-page__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 720px) {
    .studio-dev-note__details,
    .studio-intro-code { padding: 0.9rem; }
  }
</style>
