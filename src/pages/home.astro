---
import HubLayout from '../layouts/HubLayout.astro';
import SplitHero from '../components/site/SplitHero.astro';
import TagChipList from '../components/site/TagChipList.astro';
import { currentFocus, homeNextUp } from '../data/site';
import { getFeaturedProjects, getLatest42Posts, getLatestGeneralPosts, getPostPath, getProjectPath } from '../lib/content';

const [featuredProject] = await getFeaturedProjects(1);
const latestGeneralPosts = await getLatestGeneralPosts(3);
const latest42Posts = await getLatest42Posts(3);
const formatDate = (value: Date) => new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(value);
---

<HubLayout
  title="Home"
  description="Personal home for changwpa with current focus, a featured project, recent technical notes, recent 42 entries, and the next updates to make."
>
  <SplitHero
    sectionClass="page-hero page-hero--home-hub"
    eyebrow="Personal hub"
    title="지금 무엇을 만들고 있고, 무엇을 먼저 업데이트할지 보여주는 now page."
    description="이 페이지는 소개보다 현재 상태를 빠르게 확인하는 허브다. 프로젝트 하나, 최근 글, 다음 업데이트만 짧게 모아둔다."
    panelEyebrow="Now page"
    panelItems={[
      'Current focus를 먼저 본다',
      'Featured project로 현재 대표 작업을 확인한다',
      '최근 일반 글과 42 글을 따로 본다',
      'Next to update로 다음 액션을 정리한다'
    ]}
  />

  <section class="section">
    <div class="container home-bento-grid">
      <article class="panel home-bento-card home-bento-card--focus">
        <p class="eyebrow">Current focus</p>
        <h2>지금 가장 신경 쓰는 작업 축</h2>
        <ul class="utility-list">
          {currentFocus.map((item) => <li>{item}</li>)}
        </ul>
      </article>

      {featuredProject && (
        <article class="panel home-bento-card home-bento-card--feature">
          <p class="eyebrow">Featured project</p>
          <h2><a href={getProjectPath(featuredProject)}>{featuredProject.data.title}</a></h2>
          <p>{featuredProject.data.description}</p>
          <p class="meta-note">{featuredProject.data.highlight}</p>
          <TagChipList items={featuredProject.data.stack} max={5} />
          <div class="project-links">
            <a href={getProjectPath(featuredProject)}>Case detail →</a>
            <a href={featuredProject.data.repoUrl} target="_blank" rel="noreferrer" aria-label={`Open ${featuredProject.data.title} repository in a new tab`}>Repository ↗</a>
          </div>
        </article>
      )}

      <article class="panel home-bento-card home-bento-card--updates">
        <p class="eyebrow">Next to update</p>
        <h2>다음 액션</h2>
        <ul class="utility-list">
          {homeNextUp.map((item) => <li>{item}</li>)}
        </ul>
      </article>

      <article class="panel home-bento-card home-bento-card--notes">
        <p class="eyebrow">Latest technical posts</p>
        <h2>최근 일반 기술 노트</h2>
        <div class="compact-link-list">
          {latestGeneralPosts.map((post) => (
            <a class="compact-link-list__item" href={getPostPath(post)}>
              <strong>{post.data.title}</strong>
              <span>{post.data.description}</span>
              <small>{formatDate(post.data.pubDate)}</small>
            </a>
          ))}
        </div>
      </article>

      <article class="panel home-bento-card home-bento-card--forty-two">
        <p class="eyebrow">Latest 42 posts</p>
        <h2>최근 42 기록</h2>
        <div class="compact-link-list">
          {latest42Posts.map((post) => (
            <a class="compact-link-list__item" href={getPostPath(post)}>
              <strong>{post.data.title}</strong>
              <span>{post.data.description}</span>
              <small>{formatDate(post.data.pubDate)}</small>
            </a>
          ))}
        </div>
      </article>
    </div>
  </section>
</HubLayout>
