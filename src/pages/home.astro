---
import HubLayout from '../layouts/HubLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import SplitHero from '../components/site/SplitHero.astro';
import { currentFocus, homeNextUp } from '../data/site';
import { getFeaturedProjects, getLatest42Posts, getLatestGeneralPosts } from '../lib/content';

const [featuredProject] = await getFeaturedProjects(1);
const latestGeneralPosts = await getLatestGeneralPosts(3);
const latest42Posts = await getLatest42Posts(3);
---

<HubLayout
  title="Home"
  description="Personal home for changwpa with current focus, a featured project, recent technical notes, recent 42 entries, and the next updates to make."
>
  <SplitHero
    sectionClass="page-hero page-hero--home-hub"
    eyebrow="Personal hub"
    title="지금 무엇을 만들고 있고, 무엇을 먼저 업데이트할지 보여주는 now page."
    description="이 페이지는 소개보다 현재 상태를 빠르게 확인하는 허브다. 프로젝트 하나, 최근 글, 다음 업데이트만 짧게 모아둔다."
    panelEyebrow="Now page"
    panelItems={[
      'Current focus를 먼저 본다',
      'Featured project로 현재 대표 작업을 확인한다',
      '최근 일반 글과 42 글을 따로 본다',
      'Next to update로 다음 액션을 정리한다'
    ]}
  />

  <section class="section">
    <div class="container two-column">
      <div>
        <SectionTitle
          eyebrow="Current focus"
          title="지금 가장 신경 쓰는 작업 축"
          description="현재 사이트와 작업 흐름을 유지하는 데 직접 연결되는 주제만 남겨둔다."
        />
      </div>

      <aside class="panel utility-panel">
        <ul class="utility-list">
          {currentFocus.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  {featuredProject && (
    <section class="section section--tint">
      <div class="container">
        <SectionTitle
          eyebrow="Featured project"
          title="지금 기준 대표 프로젝트 한 개"
          description="현재 포트폴리오에서 가장 먼저 열어보길 원하는 프로젝트 케이스 하나만 고정한다."
        />
        <div class="home-featured-project">
          <ProjectCard project={featuredProject} />
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Latest technical blog posts"
        title="최근 일반 기술 노트"
        description="42와 분리된 일반 기술 글만 따로 묶어서 지금 무엇을 공부하고 정리했는지 보여준다."
      />
      <div class="card-grid">
        {latestGeneralPosts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionTitle
        eyebrow="Latest 42 posts"
        title="최근 42 기록"
        description="42 전용 허브로 이어지는 최근 과제 글만 따로 노출해서 학습 흐름을 바로 확인하게 한다."
      />
      <div class="card-grid">
        {latest42Posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Next to update"
        title="다음으로 손볼 작업"
        description="지금 바로 업데이트할 만한 항목만 간결하게 유지해서 `/home`이 실제 시작점이 되게 한다."
      />
      <div class="feature-grid feature-grid--compact">
        {homeNextUp.map((item) => (
          <article class="card stat-card">
            <p>{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</HubLayout>
