---
import MainLayout from '../layouts/MainLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { currentFocus, focusAreas, siteMeta, stackSummary, strengths } from '../data/site';
---

<MainLayout title="About" description="About the changwpa developer site and the working style behind it.">
  <section class="page-hero page-hero--about">
    <div class="container hero__grid">
      <div class="narrow-flow">
        <p class="eyebrow">About the notebook</p>
        <h1>A personal site for turning active project work into durable technical writing.</h1>
        <p>
          This rebuild is organized around one rule: if a project or post cannot stay useful after launch day, it needs a better editorial structure. That is why the stack stays source-first, static, and easy to keep current.
        </p>
        <p class="page-kicker">
          Portfolio notes, project summaries, and assignment writeups live together so the archive feels cohesive instead of split across unrelated surfaces.
        </p>
      </div>

      <aside class="panel utility-panel">
        <p class="eyebrow">Profile snapshot</p>
        <h2>{siteMeta.shortTitle}</h2>
        <p>{siteMeta.statusLine}</p>
        <ul class="stack-list">
          {strengths.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container two-column">
      <div>
        <SectionTitle
          eyebrow="Short biography"
          title="A systems-minded developer journal anchored in 42 work"
          description="The site focuses on C projects, infrastructure exercises, and practical notes about rebuilding and shipping source-first websites."
        />
        <p>
          Instead of separating portfolio, blog, and assignment notes into different silos, this site keeps them in one place. The result should feel coherent whether you arrive looking for a project summary, a build note, or the next entry in the 42 series.
        </p>
      </div>
      <div class="panel utility-panel">
        <p class="eyebrow">Current focus</p>
        <ul class="utility-list">
          {currentFocus.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container two-column">
      <div>
        <SectionTitle
          eyebrow="Stack summary"
          title="Chosen for maintainability over novelty"
          description="Static output, structured content, and GitHub Pages deployment keep the workflow lightweight enough to update often."
        />
        <div class="feature-grid feature-grid--compact">
          {stackSummary.map((item) => (
            <article class="card stat-card">
              <p>{item}</p>
            </article>
          ))}
        </div>
      </div>
      <aside class="panel utility-panel">
        <p class="eyebrow">Archive lanes</p>
        <ul class="utility-list">
          {focusAreas.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>
</MainLayout>
