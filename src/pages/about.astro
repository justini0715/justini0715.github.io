---
import MainLayout from '../layouts/MainLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { currentFocus, focusAreas, siteMeta, stackSummary, strengths } from '../data/site';
---

<MainLayout
  title="About changwpa"
  description="About changwpa: a developer portfolio focused on 42 projects, systems programming, technical writing, and source-first Astro publishing."
>
  <section class="page-hero page-hero--about">
    <div class="container hero__grid">
      <div class="narrow-flow">
        <p class="eyebrow">About changwpa</p>
        <h1>A developer portfolio centered on 42 projects, systems-flavored work, and technical writing.</h1>
        <p>
          This site exists to turn active repository work into clear project summaries and useful technical posts. The stack stays source-first, static, and easy to keep current so the archive can grow without turning into clutter.
        </p>
        <p class="page-kicker">
          Expect portfolio notes, 42 assignment writeups, and practical lessons from C, concurrency, infrastructure, and static publishing.
        </p>
      </div>

      <aside class="panel utility-panel">
        <p class="eyebrow">Profile snapshot</p>
        <h2>{siteMeta.shortTitle}</h2>
        <p>{siteMeta.statusLine}</p>
        <ul class="stack-list">
          {strengths.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container two-column">
      <div>
        <SectionTitle
          eyebrow="Short biography"
          title="A systems-minded developer archive anchored in 42 work"
          description="The site focuses on C projects, infrastructure exercises, and practical notes about debugging, building, and shipping source-first websites."
        />
        <p>
          Instead of separating portfolio, blog, and assignment notes into different silos, this site keeps them in one place. The result should help visitors move quickly from a project summary to a technical note to the next 42 entry in the same learning arc.
        </p>
      </div>
      <div class="panel utility-panel">
        <p class="eyebrow">Current focus</p>
        <ul class="utility-list">
          {currentFocus.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container two-column">
      <div>
        <SectionTitle
          eyebrow="Stack summary"
          title="Chosen for maintainability over novelty"
          description="Static output, structured content, and GitHub Pages deployment keep the workflow lightweight enough to update often."
        />
        <div class="feature-grid feature-grid--compact">
          {stackSummary.map((item) => (
            <article class="card stat-card">
              <p>{item}</p>
            </article>
          ))}
        </div>
      </div>
      <aside class="panel utility-panel">
        <p class="eyebrow">Archive lanes</p>
        <ul class="utility-list">
          {focusAreas.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>
</MainLayout>
